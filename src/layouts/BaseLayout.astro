---
/**
 * Every page: head and scripts from Base, the header,
 * the page, and the footer.
 */
import type { TransitionDirectionalAnimations } from 'astro';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SheetId } from '../data/sheets';

interface Props {
  title?: string;
  description?: string;
  /** The sheet this page belongs to. */
  sheet?: SheetId;
  /** Footer strip text for pages outside the five sheets. */
  strip?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { sheet, strip, title, description, ogType, noindex } = Astro.props;

// Between sheets: a short slide plus fade, about 200ms. Keyframes live in global.css.
// The header does not move; under reduced motion no animation runs at all.
const t = (name: string, easing: string) => ({ name, duration: '200ms', easing, fillMode: 'both' });
const sheetSwap: TransitionDirectionalAnimations = {
  forwards: { old: t('sheet-out-left', 'ease-in'), new: t('sheet-in-right', 'ease-out') },
  backwards: { old: t('sheet-out-right', 'ease-in'), new: t('sheet-in-left', 'ease-out') },
};
---

<Base title={title} description={description} ogType={ogType} noindex={noindex}>
  <Header active={sheet} />
  <main id="main" transition:animate={sheetSwap}>
    <slot />
  </main>
  <Footer sheet={sheet} strip={strip} />
</Base>
