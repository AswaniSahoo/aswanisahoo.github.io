---
/**
 * A post: 65ch measure, mono headings, figure captions set as chart legends, canonical URL
 * on this domain (from Base), and a note where the post first appeared.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import { posts, postHref, readingMinutes } from '../../lib/writing';

export const getStaticPaths = (async () => {
  const all = await posts();
  return all.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: all[i - 1], older: all[i + 1] } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, newer, older } = Astro.props as Props;
const { Content } = await render(post);
const d = post.data;
const minutes = readingMinutes(post.body);
---

<BaseLayout sheet="04" title={`${d.title} · Writing · Aswani Kumar Sahoo`} description={d.summary} ogType="article">
  <SheetBanner sheet="04" parts={['Writing', d.part ? `Climate-risk agent, part ${d.part}` : 'Post']} seed={(d.part ?? 1) + 3}>
    <h1>{d.title}</h1>
    <p class="meta mono">
      <time datetime={d.date}>{d.date}</time>
      <span>· {minutes} min read</span>
      {d.tags.map((t) => <span>· {t}</span>)}
    </p>
    {d.hashnode && (
      <p class="origin mono">
        First published on Hashnode. <a href={d.hashnode} target="_blank" rel="noopener noreferrer">Original post</a>
      </p>
    )}
  </SheetBanner>

  <article class="wrap post">
    <div class="body">
      <Content />
    </div>
  </article>

  <nav class="wrap pager mono" aria-label="More writing">
    {older ? <a class="older" href={postHref(older)}>{older.data.title}</a> : <span />}
    <a class="all" href="/writing/">All writing</a>
    {newer ? <a class="newer" href={postHref(newer)}>{newer.data.title}</a> : <span />}
  </nav>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .origin {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .origin a {
    color: var(--accent);
  }
  .post {
    padding-block: clamp(2rem, 4vw, 3rem) 2rem;
  }
  .body {
    max-width: 65ch;
    font-size: var(--fs-body);
    line-height: 1.7;
  }
  .body > :global(* + *) {
    margin-top: 1.1em;
  }
  .body :global(h2),
  .body :global(h3) {
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-top: 2.2em;
  }
  .body :global(h2) {
    font-size: var(--fs-h3);
  }
  .body :global(h3) {
    font-size: var(--fs-body);
  }
  .body :global(p em:only-child) {
    color: var(--muted);
  }
  .body :global(a) {
    color: var(--accent);
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.3rem;
  }
  .body :global(li + li) {
    margin-top: 0.4em;
  }
  .body :global(li::marker) {
    color: var(--accent);
  }
  .body :global(blockquote) {
    margin-inline: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--bg-2);
    border: 1px solid var(--line);
    padding: 0.05em 0.3em;
  }
  .body :global(pre) {
    background: var(--bg-2);
    border: 1px solid var(--line-strong);
    padding: 0.9rem 1rem;
    overflow-x: auto;
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .body :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .body :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }
  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: 0.4rem 0.7rem 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .body :global(th) {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--line-strong);
    margin-block: 2em;
  }
  .body :global(img) {
    border: 1px solid var(--line-strong);
  }
  /* Figure captions read as chart legends. */
  .body :global(figcaption) {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line-strong);
    padding: 0.2rem 0.5rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding-block: 1.5rem clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
  }
  .pager a {
    text-decoration: none;
  }
  .pager a:hover {
    text-decoration: underline;
  }
  .older::before {
    content: '← ';
    color: var(--accent);
  }
  .newer {
    text-align: right;
  }
  .newer::after {
    content: ' →';
    color: var(--accent);
  }
  .all {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .newer {
      text-align: left;
    }
  }
</style>
