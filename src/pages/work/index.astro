---
/** Projects: the four flagships as cards, then every other repository in a short list. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import { stations } from '../../data/projects';
import { others, reportHref } from '../../data/work';

const n = stations.length;
---

<BaseLayout
  sheet="02"
  title="Projects · Aswani Kumar Sahoo"
  description={`${n} projects: AI agents, weather and scientific ML, retrieval and MLOps. Four flagships first, each with one result and the evidence behind it.`}
>
  <SheetBanner sheet="02" parts={['Projects', `${n} in total`]}>
    <h1>Projects</h1>
    <p class="lede">Four flagships first, each with one result and a link to its evidence. Open any project for the full case study.</p>
  </SheetBanner>

  <section class="wrap work" aria-label="Flagship projects">
    <FeatureGrid />
  </section>

  <section class="wrap more" aria-labelledby="more-title">
    <h2 id="more-title">More projects</h2>
    <ul class="list">
      {others.map((s, i) => (
        <li class="row reveal" style={`--delay: ${(i % 3) * 40}ms`}>
          <a class="name" href={reportHref(s.slug)}>{s.name}</a>
          <div class="text">
            <p class="what">{s.summary}</p>
            <p class="tags mono">{s.stack.slice(0, 3).map((t) => <span>{t}</span>)}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .work {
    padding-block: 2rem 0;
  }
  .more {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(4rem, 8vw, 6rem);
  }
  .more h2 {
    font-size: var(--fs-h3);
    margin-bottom: 1rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  /* Name, then what it is and the main tools. The whole row is the link. */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 0.35rem 2rem;
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .name {
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .name::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row:hover .name,
  .name:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .text {
    display: grid;
    gap: 0.35rem;
  }
  .what {
    font-size: var(--fs-text);
    color: var(--muted);
    max-width: 62ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .tags span {
    white-space: nowrap;
  }
  .tags span + span::before {
    content: '· ';
    margin-right: 0.15rem;
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
