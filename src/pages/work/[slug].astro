---
/**
 * A station report: banner, one-line summary, status stamp, up to five stamped metrics,
 * then Problem, How it works, Evaluation, What failed and what changed, Stack, Links,
 * Related writing. Sections render only when the case has audited material for them.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import MetricTile from '../../components/MetricTile.astro';
import Receipt from '../../components/Receipt.astro';
import CraFlow from '../../components/CraFlow.astro';
import ControlLoop from '../../components/ControlLoop.astro';
import Compare from '../../components/Compare.astro';
import { comparisons } from '../../data/compare';
import { cases } from '../../data/cases';
import { stations } from '../../data/projects';
import { posts, postHref } from '../../lib/writing';

export const getStaticPaths = (() => cases.map((c) => ({ params: { slug: c.slug }, props: { c } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { c } = Astro.props as Props;
const isPrivate = c.station.isPrivate === true;
const position = stations.findIndex((s) => s.slug === c.slug) + 1;
const pad = (n: number) => String(n).padStart(2, '0');
const diagrams = { 'cra-flow': CraFlow, 'control-loop': ControlLoop };
const Diagram = c.how?.diagram ? diagrams[c.how.diagram] : undefined;
const pill = c.status.kind === 'live' ? 'merged' : c.status.kind === 'private' ? 'closed' : 'open';
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const related = c.relatedSeries ? (await posts()).filter((p) => p.data.series === c.relatedSeries) : [];
const table = c.evaluation?.table;
const comparison = comparisons[c.slug];
const barMax = table && table.barColumn !== undefined ? Math.max(...table.rows.map((r) => Number(r[table.barColumn!]))) : 0;

const present = {
  problem: Boolean(c.problem?.length),
  how: Boolean(c.how),
  evaluation: Boolean(c.evaluation),
  changes: Boolean(c.changes?.length),
  stack: true,
  links: true,
  related: related.length > 0,
};
const titles: Record<keyof typeof present, string> = {
  problem: 'Problem',
  how: 'How it works',
  evaluation: 'Evaluation',
  changes: 'What failed and what changed',
  stack: 'Stack',
  links: 'Links',
  related: 'Related writing',
};
const sections = (Object.keys(present) as (keyof typeof present)[]).filter((k) => present[k]);
const num = (id: keyof typeof present) => pad(sections.indexOf(id) + 1);
const prev = cases[position - 2];
const next = cases[position];
---

<BaseLayout sheet="02" title={`${c.name} · Work · Aswani Kumar Sahoo`} description={`${c.name}, station report. ${c.summary}`} ogType="article">
  <SheetBanner sheet="02" parts={['Station report', `${pad(position)} of ${pad(stations.length)}`]} seed={position + 5}>
    <p class="crumbs mono"><a href="/work/">Work</a> <span aria-hidden="true">/</span> {c.name}</p>
    <h1>{c.name}</h1>
    <p class="lede">{c.summary}</p>
    <div class="status">
      <span class:list={['pill', pill]}>{c.status.label}</span>
      {c.status.detail && <span class="detail mono">{c.status.detail}</span>}
      {c.status.check && <Receipt source={c.status.check.source} label={c.status.check.label} fast verifiedAt={c.status.check.verifiedAt} />}
      {isPrivate && <span class="detail mono">code on request</span>}
    </div>
  </SheetBanner>

  {c.metrics.length > 0 && (
    <section class="wrap readings" aria-label="Headline measurements">
      {c.metrics.slice(0, 5).map((m) => <MetricTile metric={m} isPrivate={isPrivate} />)}
    </section>
  )}

  {comparison && (
    <section id="compare" class="wrap compare-row" aria-label="What is different">
      <Compare c={comparison} />
    </section>
  )}

  <div class="wrap report">
    <nav class="toc" aria-label="On this page">
      <ol>
        {sections.map((id, i) => (
          <li><a href={`#${id}`}><span class="n mono" aria-hidden="true">{pad(i + 1)}</span>{titles[id]}</a></li>
        ))}
      </ol>
    </nav>

    <div class="content">
      {present.problem && (
        <section id="problem" class="block">
          <h2><span class="n mono">{num('problem')}</span>Problem</h2>
          {c.problem!.map((p) => <p class="prose">{p}</p>)}
        </section>
      )}

      {c.how && (
        <section id="how" class="block">
          <h2><span class="n mono">{num('how')}</span>How it works</h2>
          {c.how.lead && <p class="prose">{c.how.lead}</p>}
          {Diagram && <Diagram />}
          {c.how.notes && c.how.notes.length > 0 && (
            <div class="notes">
              {c.how.notes.map((n) => (
                <article class="note">
                  <h3>{n.title}</h3>
                  <p>{n.text}</p>
                  {n.metrics && (
                    <div class="note-metrics">
                      {n.metrics.map((m) => <MetricTile metric={m} isPrivate={isPrivate} />)}
                    </div>
                  )}
                  {n.readout && <Receipt source={n.readout.source} isPrivate={isPrivate} />}
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {c.evaluation && (
        <section id="evaluation" class="block">
          <h2><span class="n mono">{num('evaluation')}</span>Evaluation</h2>
          {c.evaluation.text?.map((p) => <p class="prose">{p}</p>)}
          {table && (
            <figure class="latency">
              <table class="mono">
                <caption class="sr-only">{table.caption}</caption>
                <thead>
                  <tr>
                    {table.head.map((h) => <th scope="col">{h}</th>)}
                    {table.barColumn !== undefined && <th scope="col" class="barcol"><span class="sr-only">{table.head[table.barColumn]} as a bar</span></th>}
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map((r) => (
                    <tr>
                      {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{typeof cell === 'number' ? cell.toLocaleString('en-US') : cell}</td>))}
                      {table.barColumn !== undefined && (
                        <td class="barcol"><span class="bar" style={`--w: ${((Number(r[table.barColumn]) / barMax) * 100).toFixed(1)}%`}></span></td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
              <figcaption class="legend-caption mono">
                <span>{table.caption}</span>
                <Receipt source={table.source} />
              </figcaption>
            </figure>
          )}
          {c.evaluation.metrics && c.evaluation.metrics.length > 0 && (
            <div class="eval-metrics">
              {c.evaluation.metrics.map((m) => <MetricTile metric={m} isPrivate={isPrivate} />)}
            </div>
          )}
          {c.evaluation.readouts?.map((r) => (
            <div class="readout">
              <p>{r.text}</p>
              <Receipt source={r.source} isPrivate={isPrivate} />
            </div>
          ))}
          {c.evaluation.artifacts && c.evaluation.artifacts.length > 0 && !isPrivate && (
            <p class="refs mono">
              {c.evaluation.artifacts.map((a) => <a href={a.url} {...ext}>{a.label}</a>)}
            </p>
          )}
        </section>
      )}

      {present.changes && (
        <section id="changes" class="block">
          <h2><span class="n mono">{num('changes')}</span>What failed and what changed</h2>
          <ol class="changes">
            {c.changes!.map((ch) => (
              <li class="card change">
                <h3>{ch.title}</h3>
                <dl>
                  {ch.rows.map(([k, v]) => (
                    <>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </>
                  ))}
                </dl>
                {ch.metric && <MetricTile metric={ch.metric} isPrivate={isPrivate} />}
                {ch.source && !isPrivate && <p class="refs mono"><a href={ch.source.url} {...ext}>{ch.source.label}</a></p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      <section id="stack" class="block">
        <h2><span class="n mono">{num('stack')}</span>Stack</h2>
        <ul class="chips">
          {c.stack.chips.map((t) => <li>{t}</li>)}
        </ul>
        {c.stack.proofs.length > 0 && (
          <dl class="proofs">
            {c.stack.proofs.map((p) => (
              <div class="row">
                <dt>{p.tool}</dt>
                <dd class="mono">{p.proof}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>

      <section id="links" class="block">
        <h2><span class="n mono">{num('links')}</span>Links</h2>
        {isPrivate || c.links.length === 0 ? (
          <p class="prose muted">Private repository, code on request.</p>
        ) : (
          <p class="refs mono">
            {c.links.map((l) => <a href={l.url} {...ext}>{l.label}</a>)}
          </p>
        )}
        {c.command && <div class="cmd">{c.command}</div>}
      </section>

      {present.related && (
        <section id="related" class="block">
          <h2><span class="n mono">{num('related')}</span>Related writing</h2>
          <ol class="related">
            {related.map((p) => (
              <li>
                <time class="mono" datetime={p.data.date}>{p.data.date}</time>
                <a href={postHref(p)}>{p.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      )}

      <nav class="pager mono" aria-label="Other station reports">
        {prev ? <a class="prev" href={`/work/${prev.slug}/`}>{prev.name}</a> : <span />}
        <a class="all" href="/work/">All station reports</a>
        {next ? <a class="next" href={`/work/${next.slug}/`}>{next.name}</a> : <span />}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .crumbs {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--text);
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }
  .detail {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .readings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-block: 1.5rem;
    border-block: 1px solid var(--line-strong);
  }
  .readings :global(.metric--md .metric-value) {
    font-size: 1.3rem;
    overflow-wrap: anywhere;
  }
  .compare-row {
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }
  .report {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .toc {
    position: sticky;
    top: 5rem;
    padding-top: 3rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    border-left: 1px solid var(--line-strong);
  }
  .toc a {
    display: flex;
    gap: 0.6rem;
    padding: 0.3rem 0 0.3rem 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc .n {
    font-size: 0.66rem;
    padding-top: 0.2rem;
  }
  .content {
    min-width: 0;
  }
  /* 48px a side: 96px between blocks on desktop. */
  .block {
    display: grid;
    gap: 1rem;
    padding-block: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .block h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
  }
  .block h2 .n {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .muted {
    color: var(--muted);
  }
  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .note {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    font-size: 0.95rem;
  }
  .note h3 {
    font-size: 1rem;
  }
  .note-metrics,
  .eval-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    width: 100%;
  }
  .readout {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    font-size: 0.95rem;
    max-width: 65ch;
  }
  .latency {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .latency table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .latency th,
  .latency td {
    text-align: left;
    padding: 0.45rem 0.4rem;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .latency thead th {
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.7rem;
  }
  .latency tbody th {
    font-weight: 500;
  }
  .barcol {
    width: 40%;
  }
  .bar {
    display: block;
    height: 8px;
    width: var(--w);
    background: var(--text);
  }
  /* Figure captions read as chart legends. */
  .legend-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
  }
  .refs a {
    color: var(--accent);
    text-decoration-color: transparent;
  }
  .refs a::before {
    content: '↗ ';
  }
  .refs a:hover {
    text-decoration-color: var(--accent);
  }
  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .change {
    display: grid;
    gap: 0.6rem;
    border-top: 3px solid var(--warn);
  }
  .change h3 {
    font-size: 1rem;
  }
  .change dl {
    margin: 0;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    font-size: 0.95rem;
  }
  .change dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.25rem;
  }
  .change dd {
    margin: 0;
    max-width: 65ch;
  }
  .proofs {
    margin: 0;
    display: grid;
  }
  .proofs .row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .proofs dt {
    font-weight: 500;
  }
  .proofs dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .cmd {
    max-width: 100%;
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .related li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .related time {
    font-size: 0.74rem;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding-top: 2rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pager a {
    text-decoration: none;
  }
  .pager a:hover {
    text-decoration: underline;
  }
  .pager .prev::before {
    content: '← ';
    color: var(--accent);
  }
  .pager .next {
    text-align: right;
  }
  .pager .next::after {
    content: ' →';
    color: var(--accent);
  }
  @media (max-width: 1080px) {
    .report {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .toc {
      position: static;
      padding-top: 2rem;
    }
    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      border-left: 0;
    }
    .toc a {
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--line-strong);
      font-size: 0.78rem;
    }
  }
  @media (max-width: 760px) {
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }
    .block {
      padding-block: 2rem;
    }
    .change dl,
    .proofs .row,
    .related li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
    .latency th,
    .latency td {
      white-space: normal;
    }
  }
</style>
