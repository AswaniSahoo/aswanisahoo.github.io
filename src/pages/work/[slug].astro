---
/**
 * A case study: banner, one-line summary, status, up to five measured results, then Problem,
 * How it works, Evaluation, What failed and what changed, Stack, Links, Related writing.
 * Sections render only when the case has audited material for them.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import MetricTile from '../../components/MetricTile.astro';
import Receipt from '../../components/Receipt.astro';
import CraFlow from '../../components/CraFlow.astro';
import Compare from '../../components/Compare.astro';
import { comparisons } from '../../data/compare';
import { cases } from '../../data/cases';
import { stations } from '../../data/projects';
import { posts, postHref } from '../../lib/writing';
import { codeSpans } from '../../lib/text';

export const getStaticPaths = (() => cases.map((c) => ({ params: { slug: c.slug }, props: { c } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { c } = Astro.props as Props;
const live = c.links.find((l) => l.label === 'live app')?.url;
// Results lead the page; the size of the test suite is engineering detail, listed under Stack.
// Plural only: a result can mention a test in the singular ("the 2020 test year", "trend test").
const isTests = (m: { label: string }) => /\btests\b|test functions/i.test(m.label);
const results = c.metrics.filter((m) => !isTests(m));
const suites = c.metrics.filter(isTests);
// The page opens with one result; the supporting figures open the Evaluation section.
const evalMetrics = [...results.slice(1, 5), ...(c.evaluation?.metrics ?? [])];
const evaluation = c.evaluation ?? (evalMetrics.length > 0 ? {} : undefined);
const isPrivate = c.station.isPrivate === true;
const position = stations.findIndex((s) => s.slug === c.slug) + 1;
const diagrams = { 'cra-flow': CraFlow };
const Diagram = c.how?.diagram ? diagrams[c.how.diagram] : undefined;
const pill = c.status.kind === 'live' ? 'merged' : c.status.kind === 'private' ? 'closed' : 'open';
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const related = c.relatedSeries ? (await posts()).filter((p) => p.data.series === c.relatedSeries) : [];
const table = c.evaluation?.table;
const comparison = c.how?.diagram ? undefined : comparisons[c.slug];
const barMax = table && table.barColumn !== undefined ? (table.barMax ?? Math.max(...table.rows.map((r) => Number(r[table.barColumn!])))) : 0;

const present = {
  problem: Boolean(c.problem?.length),
  evaluation: Boolean(evaluation),
  how: Boolean(c.how),
  changes: Boolean(c.changes?.length),
  stack: true,
  links: true,
  related: related.length > 0,
};
const titles: Record<keyof typeof present, string> = {
  problem: 'Problem',
  evaluation: 'Evaluation',
  how: 'How it works',
  changes: 'What failed and what changed',
  stack: 'Stack',
  links: 'Links',
  related: 'Related writing',
};
const sections = (Object.keys(present) as (keyof typeof present)[]).filter((k) => present[k]);
const prev = cases[position - 2];
const next = cases[position];
---

<BaseLayout sheet="02" title={`${c.name} · Aswani Kumar Sahoo`} description={`${c.name}, case study. ${c.summary}`} ogType="article">
  <SheetBanner sheet="02" parts={[c.station.domain]} seed={position + 5}>
    <p class="crumbs mono"><a href="/work/">Projects</a> <span aria-hidden="true">/</span> {c.name}</p>
    <h1>{c.name}</h1>
    <p class="lede">{c.summary}</p>
    <div class="status">
      <span class:list={['pill', pill]}>{c.status.label}</span>
      {c.status.detail && <span class="detail mono">{c.status.detail}</span>}
      {c.status.check && <Receipt source={c.status.check.source} label={c.status.check.label} fast verifiedAt={c.status.check.verifiedAt} />}
      {isPrivate && <span class="detail mono">code on request</span>}
    </div>
    {live && <a class="btn primary" href={live} target="_blank" rel="noopener noreferrer">Try the live app ↗</a>}
  </SheetBanner>

  {results.length > 0 && (
    <section class="wrap readings" aria-label="Headline measurements">
      <MetricTile metric={results[0]} size="lg" isPrivate={isPrivate} />
    </section>
  )}

  {c.figures && c.figures.length > 0 && (
    <section class="wrap figures" aria-label="What it looks like">
      {c.figures.map((f) => (
        <figure class:list={['shot', 'src' in f && f.size]}>
          {'code' in f ? (
            <pre class="output" aria-label={f.label}><code>{f.code.split('\n').map((line) => (
              <span class="ln" style={`--i: ${line.length - line.trimStart().length}`}>{line.trimStart() || '\u00a0'}</span>
            ))}</code></pre>
          ) : (
            <img src={f.src} width={f.width} height={f.height} alt={f.alt} loading="lazy" decoding="async" />
          )}
          <figcaption>
            <span>{f.caption}</span>
            <Receipt source={f.source} label="original" />
          </figcaption>
        </figure>
      ))}
    </section>
  )}

  {comparison && (
    <section id="compare" class="wrap compare-row" aria-label="What is different">
      <Compare c={comparison} />
    </section>
  )}

  <div class="wrap report">
    <nav class="toc" aria-label="On this page">
      <ol>
        {sections.map((id) => (
          <li><a href={`#${id}`}>{titles[id]}</a></li>
        ))}
      </ol>
    </nav>

    <div class="content">
      {present.problem && (
        <section id="problem" class="block">
          <h2>Problem</h2>
          {c.problem!.map((p) => <p class="prose">{p}</p>)}
        </section>
      )}

      {evaluation && (
        <section id="evaluation" class="block">
          <h2>Evaluation</h2>
          {evalMetrics.length > 0 && (
            <div class="eval-metrics">
              {evalMetrics.map((m) => <MetricTile metric={m} isPrivate={isPrivate} />)}
            </div>
          )}
          {evaluation.text?.map((p) => <p class="prose">{p}</p>)}
          {table && (
            <figure class="latency">
              <table class="mono">
                <caption class="sr-only">{table.caption}</caption>
                <thead>
                  <tr>
                    {table.head.map((h) => <th scope="col">{h}</th>)}
                    {table.barColumn !== undefined && <th scope="col" class="barcol"><span class="sr-only">{table.head[table.barColumn]} as a bar</span></th>}
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map((r) => (
                    <tr>
                      {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{typeof cell === 'number' ? cell.toLocaleString('en-US') : cell}</td>))}
                      {table.barColumn !== undefined && (
                        <td class="barcol"><span class="bar" style={`--w: ${((Number(r[table.barColumn]) / barMax) * 100).toFixed(1)}%`}></span></td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
              <figcaption class="legend-caption mono">
                <span>{table.caption}</span>
                <Receipt source={table.source} />
              </figcaption>
            </figure>
          )}
          {evaluation.readouts?.map((r) => (
            <div class="readout">
              <p>{r.text}</p>
              <Receipt source={r.source} isPrivate={isPrivate} />
            </div>
          ))}
          {evaluation.artifacts && evaluation.artifacts.length > 0 && !isPrivate && (
            <p class="refs mono">
              {evaluation.artifacts.map((a) => <a href={a.url} {...ext}>{a.label}</a>)}
            </p>
          )}
        </section>
      )}

      {c.how && (
        <section id="how" class="block">
          <h2>How it works</h2>
          {c.how.lead && <p class="prose">{c.how.lead}</p>}
          {Diagram && <Diagram />}
          {c.how.notes && c.how.notes.length > 0 && (
            <div class="notes">
              {c.how.notes.map((n) => (
                <article class="note">
                  <h3>{n.title}</h3>
                  <p>{n.text}</p>
                  {n.metrics && (
                    <div class="note-metrics">
                      {n.metrics.map((m) => <MetricTile metric={m} isPrivate={isPrivate} />)}
                    </div>
                  )}
                  {n.readout && <Receipt source={n.readout.source} isPrivate={isPrivate} />}
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {present.changes && (
        <section id="changes" class="block">
          <h2>What failed and what changed</h2>
          <ol class="changes">
            {c.changes!.map((ch) => (
              <li class="card change">
                <h3>{ch.title}</h3>
                <dl>
                  {ch.rows.map(([k, v]) => (
                    <>
                      <dt>{k}</dt>
                      <dd>{codeSpans(v).map((t) => (t.code ? <code>{t.text}</code> : t.text))}</dd>
                    </>
                  ))}
                </dl>
                {ch.metric && <MetricTile metric={ch.metric} isPrivate={isPrivate} />}
                {ch.source && !isPrivate && <p class="refs mono"><a href={ch.source.url} {...ext}>{ch.source.label}</a></p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      <section id="stack" class="block">
        <h2>Stack</h2>
        <ul class="chips">
          {c.stack.chips.map((t) => <li>{t}</li>)}
        </ul>
        {suites.map((m) => (
          <p class="suite">
            <b class="mono">{m.value}</b> {m.label}{m.note && <span class="muted"> · {m.note}</span>}
            <Receipt source={m.source} label={m.evidence} fast verifiedAt={m.verifiedAt} isPrivate={isPrivate} />
          </p>
        ))}
      </section>

      <section id="links" class="block">
        <h2>Links</h2>
        {isPrivate || c.links.length === 0 ? (
          <p class="prose muted">Private repository, code on request.</p>
        ) : (
          <p class="refs mono">
            {c.links.map((l) => <a href={l.url} {...ext}>{l.label}</a>)}
          </p>
        )}
        {c.command && <div class="cmd">{c.command}</div>}
      </section>

      {present.related && (
        <section id="related" class="block">
          <h2>Related writing</h2>
          <ol class="related">
            {related.map((p) => (
              <li>
                <time class="mono" datetime={p.data.date}>{p.data.date}</time>
                <a href={postHref(p)}>{p.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      )}

      <nav class="pager mono" aria-label="Other projects">
        {prev ? <a class="prev" href={`/work/${prev.slug}/`}>{prev.name}</a> : <a class="prev" href="/work/">All projects</a>}
        {next ? <a class="next" href={`/work/${next.slug}/`}>{next.name}</a> : <a class="next" href="/work/">All projects</a>}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .crumbs {
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--text);
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }
  .detail {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  /* One lead result under the banner. */
  .readings {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-block: 1.5rem;
    border-block: 1px solid var(--line-strong);
  }
  .readings > :global(.metric) {
    max-width: 60ch;
  }
  .compare-row {
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }
  .report {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .toc {
    position: sticky;
    top: 5rem;
    padding-top: 3rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    border-left: 1px solid var(--line-strong);
  }
  .toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.8rem;
    font-size: var(--fs-small);
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--text);
  }
  .content {
    min-width: 0;
  }
  /* 48px a side: 96px between blocks on desktop. */
  .block {
    display: grid;
    gap: 1rem;
    padding-block: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .block h2 {
    font-size: var(--fs-h3);
  }
  .muted {
    color: var(--muted);
  }
  /* One column: a short note never leaves a hole beside a long one. */
  .notes {
    display: grid;
    gap: 1.25rem;
    max-width: 65ch;
  }
  .note p,
  .eval-metrics :global(.metric-label) {
    max-width: 65ch;
  }
  .note {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
    padding-left: 0.9rem;
    border-left: 2px solid var(--line-strong);
    font-size: var(--fs-text);
  }
  .note h3 {
    font-size: var(--fs-body);
  }
  .note-metrics,
  .eval-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    width: 100%;
  }
  /* Two to a row, each spanning the same three rows (value, label, evidence), so the evidence
     links sit level across a row. */
  .eval-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem 1.5rem;
  }
  .eval-metrics > :global(.metric) {
    grid-row: span 3;
    grid-template-rows: subgrid;
    margin-bottom: 1rem;
  }
  /* A note is half the column: its figures stack rather than squeeze a value onto two lines. */
  .note-metrics {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .readout {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    padding-left: 0.9rem;
    border-left: 2px solid var(--line-strong);
    font-size: var(--fs-text);
    max-width: 65ch;
  }
  .latency {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .latency table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .latency th,
  .latency td {
    text-align: left;
    padding: 0.45rem 0.4rem;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* Labels may wrap on a phone; the numbers never do. */
  .latency thead th,
  .latency tbody th {
    white-space: normal;
  }
  .latency thead th {
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: var(--fs-label);
  }
  .latency tbody th {
    font-weight: 500;
  }
  .barcol {
    width: 40%;
  }
  .bar {
    display: block;
    height: 8px;
    width: var(--w);
    background: var(--text);
  }
  /* Figure captions read as chart legends. */
  .legend-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
  }
  .refs a {
    color: var(--accent);
    text-decoration-color: transparent;
  }
  .refs a::before {
    content: '↗ ';
  }
  .refs a:hover {
    text-decoration-color: var(--accent);
  }
  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .change {
    display: grid;
    gap: 0.6rem;
    border-top: 3px solid var(--warn);
  }
  .change h3 {
    font-size: var(--fs-body);
  }
  .change dl {
    margin: 0;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    font-size: var(--fs-text);
  }
  .change dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.25rem;
  }
  .change dd {
    margin: 0;
    max-width: 65ch;
  }
  .cmd {
    max-width: 100%;
  }
  .suite {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-size: var(--fs-text);
  }
  /* What it looks like: real screens and figures from the repository, each linked to its original. */
  .figures {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }
  .shot {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
  }
  /* A tool's output at a reading width; a screen at the full width so its text stays readable;
     a chart smaller, so a white figure does not take over a dark page. */
  .shot {
    max-width: 48rem;
  }
  .shot.wide {
    max-width: none;
  }
  .shot.narrow {
    max-width: 34rem;
  }
  /* A tool's output, set as text so it stays readable at any width. */
  .output {
    margin: 0;
    padding: 1rem 1.1rem;
    background: var(--bg-2);
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* A wrapped line hangs under its own first character, not at the left edge. */
  .output .ln {
    display: block;
    padding-left: calc((var(--i) + 2) * 1ch);
    text-indent: -2ch;
  }
  .shot figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .related li:last-child {
    border-bottom: 0;
  }
  .related li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-text);
  }
  .related time {
    font-size: var(--fs-label);
    color: var(--muted);
    padding-top: 0.2rem;
  }
  /* Links to other pages read like the post titles on Writing: plain, underlined on hover. */
  .related a {
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 2rem;
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pager a {
    text-decoration: none;
  }
  .pager a:hover {
    text-decoration: underline;
  }
  .pager .prev::before {
    content: '← ';
    color: var(--accent);
  }
  .pager .next {
    text-align: right;
  }
  .pager .next::after {
    content: ' →';
    color: var(--accent);
  }
  @media (max-width: 1080px) {
    .report {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .toc {
      position: static;
      padding-top: 2rem;
    }
    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      border-left: 0;
    }
    .toc a {
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--line-strong);
      font-size: var(--fs-small);
    }
  }
  @media (max-width: 760px) {
    .block {
      padding-block: 2rem;
    }
    .eval-metrics {
      grid-template-columns: minmax(0, 1fr);
    }
    .change dl,
    .related li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
    .latency th,
    .latency td {
      white-space: normal;
    }
    .barcol {
      display: none;
    }
  }
</style>
