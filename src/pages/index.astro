---
/**
 * The home page: who this is in a few seconds, then routes out. The hero, four flagship
 * projects, the open-source record, the latest writing; the contact band comes from the layout.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import UpstreamStrip from '../components/UpstreamStrip.astro';
import LatestWriting from '../components/LatestWriting.astro';
import { stations } from '../data/projects';
---

<BaseLayout sheet="01">
  <script is:inline>
    // Links into the old single page land on the sheet that now holds that section.
    (function () {
      var moved = {
        '#atmosphere': '/open-source/#graph-weather',
        '#agents': '/work/',
        '#instruments': '/about/#how-i-work',
        '#stations': '/work/',
        '#upstream': '/open-source/',
        '#against-me': '/about/#against-me',
        '#writing': '/writing/',
        '#about': '/about/',
      };
      var to = moved[location.hash];
      if (to) location.replace(to);
    })();
  </script>
  <Hero />

  <Section id="work" label="Projects" title="Selected work">
    <FeatureGrid />
    <p class="more mono"><a href="/work/">All {stations.length} projects</a></p>
  </Section>

  <UpstreamStrip />

  <Section id="writing" label="Writing" title="Latest writing" compact>
    <LatestWriting />
  </Section>

</BaseLayout>

<style>
  .more {
    margin-top: 1.75rem;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .more a {
    text-decoration: none;
  }
  .more a::after {
    content: ' →';
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
  }
</style>
