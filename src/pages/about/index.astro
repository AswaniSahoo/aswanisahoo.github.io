---
/** About: who, education and experience, how I work, results that went against me, certifications, stack, contact. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import MetricTile from '../../components/MetricTile.astro';
import Receipt from '../../components/Receipt.astro';
import { profile } from '../../data/profile';
import { certifications } from '../../data/certs';
import { instruments, meshSeries } from '../../data/projects';
import { negativeResults } from '../../data/negative';
import { resumeHref } from '../../lib/resume';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout
  sheet="05"
  title="About · Aswani Kumar Sahoo"
  description={`${profile.name}: ${profile.title}. ${profile.education.degree}, ${profile.education.school}. How I work, results that went against me, certifications and contact.`}
>
  <SheetBanner sheet="05" parts={['About', profile.location]}>
    <h1>{profile.name}</h1>
    <p class="lede">{profile.origin.line}</p>
    <p class="avail mono"><span class="dot" aria-hidden="true"></span>{profile.availability}{resumeHref && <> · <a href={resumeHref} target="_blank" rel="noopener">résumé (PDF)</a></>}</p>
  </SheetBanner>

  <section class="wrap cols section-block first" aria-label="Education and experience">
    <article class="card fact">
      <p class="eyebrow">Education</p>
      <h2>{profile.education.degree}</h2>
      <p>{profile.education.school}</p>
      <p class="mono meta">{profile.education.years} · CGPA {profile.education.cgpa}</p>
      <p class="muted">{profile.education.note}</p>
    </article>
    <article class="card fact">
      <p class="eyebrow">Experience</p>
      <h2>graph_weather adaptive-mesh mentorship</h2>
      <p class="mono meta">May 20 to July 20, 2026 · with Jacob Prince-Bieker</p>
      <p>
        Worked on implementation of advanced moveable high-resolution graph weather forecasting models in the graph_weather repository: added regional forecasting meshes, debugged and improved the graph representation, and wrote up in-depth analysis and investigations into the internals of the models.
      </p>
      <MetricTile metric={meshSeries.metrics[0]} />
      <p class="refs mono"><a href="/open-source/#graph-weather">the graph_weather story</a></p>
    </article>
  </section>

  <section id="how-i-work" class="wrap section-block" aria-labelledby="how-title">
    <div class="head">
      <h2 id="how-title">How I work</h2>
      <p class="prose muted">Every public number links to its evidence: an eval report, a CI run, or the pull request itself. Numbers from private repos are marked private.</p>
    </div>
    <div class="panels">
      {instruments.map((panel, i) => (
        <article class="card panel reveal" style={`--delay: ${i * 60}ms`}>
          <p class="eyebrow">{panel.heading}</p>
          <ul class="readouts">
            {panel.items.map((it) => (
              <li>
                <p>{it.text}</p>
                <Receipt source={it.source} />
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="against-me" class="wrap section-block" aria-labelledby="against-title">
    <div class="head">
      <h2 id="against-title">Results that went against me</h2>
      <p class="prose muted">Three findings I published even though each one made my own work look worse. A number nobody is allowed to doubt is worth more than a better number nobody can check.</p>
    </div>
    <div class="results">
      {negativeResults.map((r, i) => (
        <article class="card result reveal" style={`--delay: ${i * 60}ms`}>
          <h3>{r.title}</h3>
          <dl>
            <dt>Claim tested</dt>
            <dd>{r.claimTested}</dd>
          </dl>
          <MetricTile metric={r.number} />
          <p class="why">{r.whyItMatters}</p>
          <details class="detail">
            <summary class="mono">What happened</summary>
            <p>{r.whatHappened}</p>
          </details>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap cols section-block" aria-label="Certifications and stack">
    <article class="card fact">
      <p class="eyebrow">Certifications · official names from Oracle's catalog</p>
      <ul class="certs">
        {certifications.map((c) => (
          <li>
            <span class="name">{c.name}</span>
            <span class="mono meta">issued {c.issued} · valid to {c.validTo}</span>
          </li>
        ))}
      </ul>
    </article>
    <article id="stack" class="card fact">
      <p class="eyebrow">Stack, with the repository that proves each line</p>
      <dl class="stack">
        {profile.stack.map((s) => (
          <div class="row">
            <dt>{s.tool}</dt>
            <dd class="mono">{s.proof}</dd>
          </div>
        ))}
      </dl>
    </article>
  </section>

  <section id="contact" class="wrap section-block last" aria-labelledby="contact-title">
    <div class="contact card boxed">
      <div>
        <p class="eyebrow"><b>Contact</b> / {profile.location}</p>
        <h2 id="contact-title">Write to me</h2>
      </div>
      <div class="ways">
        <a class="mail mono" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p class="links mono">
          <a href={profile.links.github} {...ext}>GitHub</a>
          <a href={profile.links.linkedin} {...ext}>LinkedIn</a>
          <a href={profile.links.x} {...ext}>X</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .avail {
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    vertical-align: 0.1em;
  }
  .section-block {
    display: grid;
    gap: 1.25rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line-strong);
  }
  .section-block.first {
    border-top: 0;
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .section-block.last {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .head {
    display: grid;
    gap: 0.5rem;
  }
  .head h2 {
    font-size: var(--fs-h3);
  }
  .cols {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }
  .fact {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
  }
  .fact h2 {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
  }
  .meta {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .refs {
    font-size: var(--fs-label);
  }
  .refs a {
    color: var(--accent);
    text-decoration-color: transparent;
  }
  .refs a::before {
    content: '→ ';
  }
  .refs a:hover {
    text-decoration-color: var(--accent);
  }
  .panels,
  .results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .panel {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }
  .readouts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .readouts li {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    font-size: var(--fs-text);
  }
  .result {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    border-top: 3px solid var(--warn);
  }
  .result dl {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--fs-text);
  }
  .result dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.4rem;
  }
  .result dd {
    margin: 0;
  }
  .why {
    color: var(--muted);
    font-size: var(--fs-text);
    border-top: 1px dashed var(--line);
    padding-top: 0.8rem;
  }
  /* The full account, one click away, so the three cards read at a glance. */
  .detail summary {
    cursor: pointer;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    list-style: none;
  }
  .detail summary::-webkit-details-marker {
    display: none;
  }
  .detail summary::before {
    content: '+ ';
    color: var(--accent);
  }
  .detail[open] summary::before {
    content: '− ';
  }
  .detail p {
    margin-top: 0.6rem;
    font-size: var(--fs-text);
  }
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .certs li {
    display: grid;
    gap: 0.1rem;
    font-size: var(--fs-text);
  }
  .stack {
    margin: 0;
    display: grid;
    width: 100%;
  }
  .stack .row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-text);
  }
  .stack .row:last-child {
    border-bottom: 0;
  }
  .stack dt {
    font-weight: 500;
  }
  .stack dd {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem 2.5rem;
    align-items: end;
  }
  .contact:hover {
    transform: none;
  }
  .contact h2 {
    margin-top: 0.5rem;
  }
  .ways {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .mail {
    font-size: clamp(0.95rem, 2.2vw, 1.3rem);
    font-weight: 500;
    text-decoration-color: var(--accent);
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: var(--fs-small);
  }
  .links a {
    text-decoration: none;
  }
  .links a::before {
    content: '↗ ';
    color: var(--accent);
  }
  .links a.internal::before {
    content: '↓ ';
  }
  .links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 960px) {
    .cols,
    .panels,
    .results,
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .stack .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
