---
/** About: who, education and experience, how I work, results that went against me, certifications, stack, contact. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import MetricTile from '../../components/MetricTile.astro';
import Receipt from '../../components/Receipt.astro';
import { profile } from '../../data/profile';
import { certifications } from '../../data/certs';
import { principles, meshSeries } from '../../data/projects';
import { negativeResults } from '../../data/negative';
import { resumeHref } from '../../lib/resume';
import { hyphenSafe } from '../../lib/text';
---

<BaseLayout
  sheet="05"
  title="About · Aswani Kumar Sahoo"
  description={`${profile.name}: ${profile.title}. ${profile.education.degree}, ${profile.education.school}. How I work, results that went against me, certifications and contact.`}
>
  <SheetBanner sheet="05" parts={['About', profile.location]}>
    <h1>{profile.name}</h1>
    <p class="lede">{profile.origin.line}</p>
    <p class="avail mono"><span class="dot" aria-hidden="true"></span>{profile.availabilityDetail}{resumeHref && <> · <a href={resumeHref} target="_blank" rel="noopener">résumé (PDF)</a></>}</p>
  </SheetBanner>

  <section class="wrap cols section-block first" aria-label="Education and experience">
    <article class="card fact">
      <p class="eyebrow">Education</p>
      <h2>{profile.education.degree}</h2>
      <p>{profile.education.school}</p>
      <p class="mono meta">{profile.education.years} · CGPA {profile.education.cgpa}</p>
      <p>{profile.education.note}</p>
      <p class="eyebrow sub">Certifications · Oracle</p>
      <ul class="certs">
        {certifications.map((c) => (
          <li>
            <span class="name">{c.name}</span>
            <span class="mono meta">issued {c.issued} · valid to {c.validTo}</span>
          </li>
        ))}
      </ul>
    </article>
    <article class="card fact">
      <p class="eyebrow">Experience</p>
      <h2>graph_weather adaptive-mesh mentorship</h2>
      <p class="mono meta">May 20 to July 20, 2026 · with Jacob Prince-Bieker</p>
      <p>
        Built regional and stretched-mesh forecasting for graph_weather, and found why its regional forecasts barely beat a no-change forecast. The fix cut forecast error on unseen regions by <span class="nb">17% (<a href={`${meshSeries.repo}/pull/237`} target="_blank" rel="noopener noreferrer">PR #237</a>).</span>
      </p>
      <MetricTile metric={meshSeries.metrics[0]} />
      <p class="refs mono"><a href="/open-source/#graph-weather">the graph_weather story</a></p>
    </article>
  </section>

  <section id="how-i-work" class="wrap section-block" aria-labelledby="how-title">
    <div class="head">
      <h2 id="how-title">How I work</h2>
    </div>
    <ol class="principles">
      {principles.map((pr, i) => (
        <li class="reveal" style={`--delay: ${(i % 2) * 60}ms`}>
          <p>{pr.text}</p>
          <Receipt source={pr.source} label={pr.label} />
        </li>
      ))}
    </ol>
  </section>


  <section class="wrap section-block" aria-label="Stack">
    <article id="stack" class="card fact">
      <p class="eyebrow">Stack, with the repository that proves each line</p>
      <dl class="stack">
        {profile.stack.map((s) => (
          <div class="row">
            <dt>{s.tool}</dt>
            <dd>{hyphenSafe(s.proof).map((t) => (t.keep ? <span class="nb">{t.text}</span> : t.text))}</dd>
          </div>
        ))}
      </dl>
    </article>
  </section>

  <section id="against-me" class="wrap section-block" aria-labelledby="against-title">
    <h2 id="against-title">Results that went against me</h2>
    <p class="prose muted">I publish them with the wins. Each is told on its project page.</p>
    <ul class="against">
      {negativeResults.map((r) => <li><a href={r.where}>{r.title}</a></li>)}
    </ul>
  </section>

</BaseLayout>

<style>
  .avail {
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    vertical-align: 0.1em;
  }
  .section-block {
    display: grid;
    gap: 1.25rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line-strong);
  }
  .section-block.first {
    border-top: 0;
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .section-block.last {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .head {
    display: grid;
    gap: 0.5rem;
  }
  .head h2 {
    font-size: var(--fs-h3);
  }
  .cols {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
  }
  .fact .sub {
    margin-top: 0.8rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line);
    width: 100%;
  }
  .fact :global(.metric) {
    margin-top: 0.4rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line);
    width: 100%;
  }
  .fact {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
  }
  .fact h2 {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
  }
  .meta {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .refs {
    font-size: var(--fs-label);
  }
  .refs a {
    color: var(--accent);
    text-decoration-color: transparent;
  }
  .refs a::before {
    content: '→ ';
  }
  .refs a:hover {
    text-decoration-color: var(--accent);
  }
  /* Four lines, two by two, each with its proof under it. */
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    counter-reset: principle;
  }
  .principles li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.35rem 0;
    align-content: start;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
    counter-increment: principle;
  }
  .principles li::before {
    content: counter(principle, decimal-leading-zero);
    grid-row: 1 / 3;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
    padding-top: 0.3rem;
  }
  .principles p {
    font-size: var(--fs-body);
    max-width: 52ch;
  }
  .principles :global(.receipt) {
    justify-self: start;
  }
  .against {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .against li:last-child {
    border-bottom: 0;
  }
  .against li {
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  .against a {
    font-weight: 600;
    text-decoration: none;
  }
  .against a::after {
    content: '\00a0→';
    color: var(--accent);
  }
  .against a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .certs li {
    display: grid;
    gap: 0.1rem;
    font-size: var(--fs-text);
  }
  .stack {
    margin: 0;
    display: grid;
    width: 100%;
  }
  .stack .row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-text);
  }
  .stack .row:last-child {
    border-bottom: 0;
  }
  .stack dt {
    font-weight: 500;
  }
  .stack dd {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  @media (max-width: 960px) {
    .cols,
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .stack .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
