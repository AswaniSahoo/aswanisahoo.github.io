---
/** Open source: the merged PRs by project, the graph_weather story first, then every PR. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SheetBanner from '../../components/SheetBanner.astro';
import OrgBars from '../../components/OrgBars.astro';
import MetricTile from '../../components/MetricTile.astro';
import Receipt from '../../components/Receipt.astro';
import ledger from '../../data/prs.json';
import { upstreamHeadline, mergedByOrg, ledgerId } from '../../data/upstream';
import { docathon, meshSeries } from '../../data/projects';
import { negativeResults } from '../../data/negative';
import { hyphenSafe } from '../../lib/text';
import type { PrLedger, PullRequest } from '../../data/types';

const data = ledger as PrLedger;
const h = upstreamHeadline;
const counts = Object.fromEntries(mergedByOrg.map((o) => [o.name, o.merged]));
const ablation = negativeResults.find((r) => r.title === 'I tested my own mesh claim, and it did not hold');
if (!ablation) throw new Error('open-source: the #238 ablation is missing from negative.ts');

// Merged and closed PRs per project, in the order the headline counts them, then the rest.
const order = [...mergedByOrg.map((o) => o.name), ...Object.keys(data.byProject).filter((p) => !counts[p])];
const groups = order.map((project) => {
  const prs = data.prs.filter((pr) => pr.project === project && pr.status !== 'open');
  const any = data.prs.find((pr) => pr.project === project);
  return { project, org: any?.org ?? '', counts: data.byProject[project], prs, manyRepos: new Set(prs.map((pr) => pr.repo)).size > 1 };
});
const open: PullRequest[] = data.prs.filter((pr) => pr.status === 'open');
const pr = (n: number) => `${meshSeries.repo}/pull/${n}`;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout
  sheet="03"
  title="Open source · Aswani Kumar Sahoo"
  description={`${h.merged} merged open-source pull requests across ${h.orgs} projects: graph_weather, PyTorch and ExecuTorch docs, krkn-chaos and MalariaGEN. The graph_weather decoder fix, and every PR listed.`}
>
  <SheetBanner sheet="03" parts={['Open source', `${h.merged} merged PRs`]}>
    <h1>Open source</h1>
    <p class="lede">Code and docs I have contributed to other people's projects, most of it to a weather model at Open Climate Fix. Every PR is listed below, closed ones included.</p>
  </SheetBanner>

  <section class="wrap headline-row" aria-label="Merged pull requests">
    <div class="headline reveal">
      <p class="big"><span class="bignum mono">{h.merged}</span> merged PRs across {h.orgs} projects</p>
      <Receipt source="#ledger" label="every PR, below" />
      <OrgBars base="" />
    </div>
    <article class="card boxed docathon reveal" style="--delay: 60ms">
      <p class="eyebrow"><b>Recognition</b></p>
      <h2>{docathon.title}</h2>
      <p class="big-result">{docathon.result}</p>
      <p class="muted">{docathon.detail}</p>
      <Receipt source={docathon.source} />
    </article>
  </section>

  <section id="graph-weather" class="wrap section-block" aria-labelledby="story-title">
    <article class="card boxed story">
      <p class="eyebrow"><b>Featured</b> · Open Climate Fix · graph_weather</p>
      <h2 id="story-title">The decoder was forecasting persistence</h2>
      <p class="prose">{meshSeries.summary}</p>
      <div class="finding">
        <p class="prose">{meshSeries.finding.text}</p>
        <div class="finding-metrics">
          <MetricTile metric={meshSeries.finding.metric} />
          <MetricTile metric={meshSeries.metrics[0]} />
        </div>
        <p class="refs mono">
          <a href={pr(237)} {...ext}>PR #237, stretched model</a>
          <a href={pr(239)} {...ext}>PR #239, regional model</a>
          <a href={meshSeries.issue} {...ext}>issue #3, the coordination thread</a>
        </p>
      </div>
      <div class="against">
        <p class="eyebrow"><b>Then it went against me</b> · issue #238</p>
        <h3>{ablation.title}</h3>
        <MetricTile metric={ablation.number} />
        <p class="prose muted">{ablation.whyItMatters}</p>
        <details class="account">
          <summary class="mono">What happened</summary>
          <p class="prose">{ablation.whatHappened}</p>
        </details>
      </div>
      <ol class="arc">
        {meshSeries.arc.map((a) => (
          <li>
            <span class="range mono">{a.range}</span>
            <span class="when mono">{a.when}</span>
            <span class="what">{a.what}</span>
          </li>
        ))}
      </ol>
    </article>
  </section>

  <section id="ledger" class="wrap section-block" aria-labelledby="ledger-title">
    <h2 id="ledger-title">Every PR, by project</h2>
    <p class="prose muted">Merged and closed PRs per project; open ones are listed after. Open a project to see its PRs. Regenerated from the GitHub API on {data.verifiedAt}.</p>
    <div class="groups">
      {groups.map((g, i) => (
        <details id={ledgerId(g.project)} class="group" open={i === 0}>
          <summary>
            <span class="gname mono">{g.project}</span>
            <span class="gorg">{g.org}</span>
            <span class="gcounts">
              {g.counts.merged > 0 && <span class="pill merged">{g.counts.merged} merged</span>}
              {g.counts.closed > 0 && <span class="pill closed">{g.counts.closed} closed</span>}
              {g.counts.open > 0 && <span class="pill open">{g.counts.open} open</span>}
            </span>
          </summary>
          {g.prs.length > 0 ? (
            <table>
              <caption class="sr-only">{g.project}: merged and closed pull requests</caption>
              <tbody>
                {g.prs.map((p) => (
                  <tr>
                    <td class="prnum mono"><a href={p.url} {...ext}>#{p.number}</a></td>
                    <td class="title"><a href={p.url} {...ext}>{p.title}</a></td>
                    {g.manyRepos && <td class="repo mono">{p.repo}</td>}
                    <td class="date mono">{p.date}</td>
                    <td class="status"><span class:list={['pill', p.status]}>{p.status}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="none muted">No merged or closed PRs yet; see the open list.</p>
          )}
        </details>
      ))}
    </div>
  </section>

  <section id="open" class="wrap section-block" aria-labelledby="open-title">
    <h2 id="open-title">Open PRs</h2>
    <ul class="open-list">
      {open.map((p) => (
        <li>
          <span class="repo mono">{hyphenSafe(p.repo).map((t) => (t.keep ? <span class="nb">{t.text}</span> : t.text))}</span>
          <a href={p.url} {...ext}><span class="mono">#{p.number}</span> {p.title}</a>
          <span class="opened mono">opened {p.date}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="how" class="wrap section-block last" aria-labelledby="how-title">
    <h2 id="how-title">How this list is built</h2>
    <p class="prose muted">
      One script, <code>scripts/refresh-prs.mjs</code>, queries every repository through the GitHub CLI and writes the list with the date it ran. A PR counts as merged when the API says so or when it carries a Merged label: PyTorch, ExecuTorch and MalariaGEN merge through bots, which GitHub's own is:merged filter misses. Anything closed without merging stays listed.
    </p>
  </section>
</BaseLayout>

<style>
  .headline-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .headline {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }
  .big {
    font-size: var(--fs-lede);
    font-weight: 500;
    line-height: 1.35;
  }
  .bignum {
    display: block;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .headline :global(.orgs) {
    margin-top: 0.6rem;
  }
  .docathon {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .docathon h2 {
    font-size: var(--fs-h3);
  }
  .big-result {
    font-size: var(--fs-lede);
    font-weight: 600;
    color: var(--accent);
  }
  .section-block {
    display: grid;
    gap: 1rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line-strong);
  }
  .section-block.last {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .section-block h2 {
    font-size: var(--fs-h3);
  }
  /* Explicit single column: an auto-fit grid inside must not size the card from its max-width. */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .story:hover,
  .docathon:hover {
    transform: none;
  }
  .section-block .story h2 {
    font-size: var(--fs-h2);
  }
  .muted {
    color: var(--muted);
  }
  .finding {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
  }
  .finding-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 1.5rem;
    max-width: 44rem;
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: var(--fs-label);
  }
  .refs a {
    color: var(--accent);
    text-decoration-color: transparent;
  }
  .refs a::before {
    content: '↗ ';
  }
  .refs a:hover {
    text-decoration-color: var(--accent);
  }
  .against {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
    justify-items: start;
    padding-top: 1.1rem;
    border-top: 2px solid var(--warn);
  }
  .against h3 {
    font-size: var(--fs-body);
  }
  .account summary {
    cursor: pointer;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    list-style: none;
  }
  .account summary::-webkit-details-marker {
    display: none;
  }
  .account summary::before {
    content: '+ ';
    color: var(--accent);
  }
  .account[open] summary::before {
    content: '− ';
  }
  .account p {
    margin-top: 0.6rem;
  }
  .arc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-left: 1px solid var(--line-strong);
  }
  .arc li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    grid-template-areas: 'range when' 'range what';
    column-gap: 0.9rem;
    padding: 0.6rem 0 0.6rem 1rem;
    position: relative;
  }
  .arc li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.95rem;
    width: 7px;
    height: 7px;
    background: var(--accent);
  }
  .range {
    grid-area: range;
    font-size: var(--fs-small);
    color: var(--accent);
    white-space: nowrap;
  }
  .when {
    grid-area: when;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .what {
    grid-area: what;
    font-size: var(--fs-text);
  }
  .groups {
    display: grid;
    gap: 0.6rem;
  }
  .group {
    border: 1px solid var(--line-strong);
    background: var(--card);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* A plus that turns into a minus, so each project reads as something to open. */
  summary::before {
    content: '+';
    width: 1ch;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .group[open] > summary::before {
    content: '−';
  }
  summary:hover .gname {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .gname {
    font-size: var(--fs-text);
    font-weight: 600;
  }
  .gorg {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .gcounts {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-left: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-text);
  }
  td {
    padding: 0.5rem 0.6rem;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  td a {
    text-decoration: none;
  }
  td a:hover {
    text-decoration: underline;
  }
  .prnum {
    width: 5.5rem;
    color: var(--accent);
    font-size: var(--fs-small);
  }
  .repo {
    width: 15rem;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .date {
    width: 7rem;
    color: var(--muted);
    font-size: var(--fs-label);
    white-space: nowrap;
  }
  /* Right edge matches the summary's, so row badges sit under the header's. */
  .status {
    width: 5.5rem;
    text-align: right;
    padding-right: 1rem;
  }
  .none {
    padding: 0 1rem 0.9rem;
    font-size: var(--fs-small);
  }
  .open-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .open-list li {
    display: grid;
    grid-template-columns: 19rem minmax(0, 1fr) auto;
    gap: 0.3rem 1rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-text);
  }
  .open-list a {
    text-decoration: none;
  }
  .open-list a:hover {
    text-decoration: underline;
  }
  .open-list .repo {
    width: auto;
  }
  .opened {
    color: var(--muted);
    font-size: var(--fs-label);
    white-space: nowrap;
  }
  #how .prose {
    max-width: 70ch;
  }
  #how code {
    font-size: 0.9em;
  }
  @media (max-width: 960px) {
    .headline-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .repo {
      display: none;
    }
    .open-list li {
      grid-template-columns: minmax(0, 1fr);
    }
    .open-list .repo {
      display: block;
    }
  }
  @media (max-width: 600px) {
    .date {
      display: none;
    }
    .arc li {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'range' 'when' 'what';
    }
    .gcounts {
      margin-left: 0;
    }
  }
</style>

<script>
  // A link to one org's group (#ledger-...) opens that group, from this sheet or from another.
  const openTarget = () => {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  document.addEventListener('astro:page-load', openTarget);
  window.addEventListener('hashchange', openTarget);
</script>
