---
/** A simplified station model: cover = test suite in oktas, barb ticks = public surfaces. */
import type { Station } from '../data/types';
import { cover, oktas, ticks } from '../lib/glyph';

interface Props {
  station: Station;
}
const { station } = Astro.props;
---

<svg class="glyph" width="44" height="34" viewBox="0 0 44 34" aria-hidden="true">
  <circle cx="14" cy="20" r="9" fill="none" stroke="currentColor" stroke-width="1.3" />
  <path d={cover(oktas(station), 14, 20, 9)} fill="currentColor" />
  <g class="barb" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
    <path d="M21 14l17 -10" />
    {Array.from({ length: ticks(station) }, (_, k) => {
      const t = 1 - k * 0.22;
      const x = 21 + 17 * t;
      const y = 14 - 10 * t;
      return <path d={`M${x.toFixed(1)} ${y.toFixed(1)}l3.2 2.8`} />;
    })}
  </g>
</svg>

<style>
  .glyph {
    color: var(--text);
    margin-top: 0.1rem;
    flex-shrink: 0;
  }
  .barb {
    transform-origin: 21px 14px;
    transition: transform 400ms var(--ease);
  }
  :global(.station:hover) .barb {
    transform: rotate(-6deg);
  }
</style>
