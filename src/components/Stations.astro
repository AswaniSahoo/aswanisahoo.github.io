---
/**
 * Station reports: every substantive own repository as a station on the chart.
 * On the Work sheet each card is one link to its report page. Grid cards carry at most
 * two stamps, at reduced contrast; the full set lives on the report page.
 * The filter chips are radio inputs, so filtering works without JavaScript.
 */
import MetricTile from './MetricTile.astro';
import StationGlyph from './StationGlyph.astro';
import { stations } from '../data/projects';
import { areaFilters, areasOf, reportHref } from '../data/work';
import { cover } from '../lib/glyph';
import type { Metric, Station } from '../data/types';

/** Headline metric first, then the test suite (or the second metric when there is no suite). */
const shown = (s: Station): Metric[] => [s.metrics[0], s.tests ?? s.metrics[1]].filter((m): m is Metric => Boolean(m));
---

<div class="stations">
  <p class="legend mono">
    <span class="key"><svg width="30" height="22" viewBox="0 0 30 22" aria-hidden="true"><circle cx="9" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="1.2" /><path d={cover(4, 9, 12, 6)} fill="currentColor" /><path d="M14 8l9 -6M20 5l3 1M17.5 6.7l3 1" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg></span>
    cover = test suite in oktas (0 to 8) · barb ticks = public surfaces: repository, live app, container, registry
  </p>

  <fieldset class="filters">
    <legend class="sr-only">Show stations by area</legend>
    {areaFilters.map((f) => (
      <span class="chip">
        <input type="radio" name="area" id={`area-${f.id}`} value={f.id} checked={f.id === 'all'} />
        <label for={`area-${f.id}`}>{f.label}</label>
      </span>
    ))}
  </fieldset>

  <div class="grid">
    {stations.map((s, i) => (
      <article class="card station reveal" id={s.slug} data-areas={areasOf(s.slug).join(' ')} style={`--delay: ${(i % 3) * 60}ms`}>
        <header class="head">
          <StationGlyph station={s} />
          <div class="title">
            <p class="eyebrow">{s.domain}</p>
            <h2 class="name"><a href={reportHref(s.slug)}>{s.name}</a></h2>
            <span class:list={['pill', s.status.kind === 'live' ? 'merged' : s.status.kind === 'private' ? 'closed' : 'open']}>{s.status.label}</span>
          </div>
        </header>

        <p class="summary">{s.summary}</p>

        {shown(s).length > 0 && (
          <div class="metrics">
            {shown(s).map((m) => <MetricTile metric={m} isPrivate={s.isPrivate} />)}
          </div>
        )}

        <footer class="foot">
          <ul class="chips">
            {s.stack.map((t) => <li>{t}</li>)}
          </ul>
          {s.links.length > 0 ? (
            <p class="links mono">
              {s.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
              ))}
            </p>
          ) : (
            <p class="links mono muted">private repository, code on request</p>
          )}
          <span class="go mono" aria-hidden="true">Station report</span>
        </footer>
      </article>
    ))}
  </div>
</div>

<style>
  .legend {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .key {
    color: var(--text);
    display: inline-flex;
    flex-shrink: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }
  .chip label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    border: 1px solid var(--line-strong);
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    transition: color 200ms var(--ease), background 200ms var(--ease), border-color 200ms var(--ease);
  }
  .chip label:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .chip input:checked + label {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }
  .chip input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* One rule per chip id in src/data/work.ts. */
  .stations:has(#area-agents:checked) .station:not([data-areas~='agents']),
  .stations:has(#area-science:checked) .station:not([data-areas~='science']),
  .stations:has(#area-retrieval:checked) .station:not([data-areas~='retrieval']),
  .stations:has(#area-mlops:checked) .station:not([data-areas~='mlops']) {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }
  .station {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.2rem 1.25rem 1.1rem;
    min-width: 0;
  }
  .station:focus-within {
    border-color: var(--text);
  }
  .head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .title {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    justify-items: start;
  }
  .name {
    font-family: var(--font-sans);
    font-size: 1rem;
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
  }
  .name a {
    text-decoration: none;
  }
  /* The whole card is the link; stamps and external links sit above it. */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .metrics :global(a),
  .links a {
    position: relative;
    z-index: 1;
  }
  .summary {
    font-size: 0.93rem;
    color: var(--text);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.9rem 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line-strong);
  }
  .metrics :global(.metric--md .metric-value) {
    font-size: 1.25rem;
  }
  .foot {
    display: grid;
    gap: 0.7rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    margin-top: auto;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }
  .links a {
    color: var(--accent);
    text-decoration-color: transparent;
  }
  .links a::before {
    content: '↗ ';
  }
  .links a:hover {
    text-decoration-color: var(--accent);
  }
  .links.muted {
    color: var(--muted);
  }
  .go {
    justify-self: end;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }
  .go::after {
    content: ' →';
    color: var(--accent);
  }
  .station:hover .go {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .legend {
      align-items: flex-start;
    }
  }
</style>
