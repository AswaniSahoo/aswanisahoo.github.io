---
/** Home sheet: the latest posts, newest first, date + title + one line. At most three. */
import { writingIndex } from '../lib/writing';

const latest = (await writingIndex()).slice(0, 3);
---

<ol class="posts">
  {latest.map((p) => (
    <li class="reveal">
      <time class="date mono" datetime={p.date}>{p.date}</time>
      <div class="body">
        <h3>
          {p.external ? (
            <a class="ext" href={p.href} target="_blank" rel="noopener noreferrer">{p.title}</a>
          ) : (
            <a href={p.href}>{p.title}</a>
          )}
        </h3>
        <p class="line">{p.summary}</p>
      </div>
    </li>
  ))}
</ol>
<p class="more mono"><a href="/writing/">All writing</a></p>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  .posts li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .date {
    font-size: 0.75rem;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .body {
    display: grid;
    gap: 0.35rem;
    max-width: 65ch;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a.ext::after {
    content: ' ↗';
    color: var(--muted);
    font-size: 0.85em;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .line {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .more {
    margin-top: 1.25rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .more a {
    text-decoration: none;
  }
  .more a::after {
    content: ' →';
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .posts li {
      grid-template-columns: 1fr;
    }
  }
</style>
