---
import { profile } from '../data/profile';
import { sheets, type SheetId } from '../data/sheets';

interface Props {
  /** The sheet this page belongs to. Its nav item carries the red underline. */
  active?: SheetId;
}
const { active } = Astro.props;
const path = Astro.url.pathname;

// Sheet 01 is the wordmark itself; the nav lists the other four.
const nav = sheets.filter((s) => s.n !== '01');
const current = (href: string, n: SheetId) => (path === href ? 'page' : active === n ? 'true' : undefined);
---

<header class="site-header" transition:animate="none">
  <div class="progress" aria-hidden="true"></div>
  <div class="wrap bar">
    <a class="wordmark mono" href="/" aria-current={path === '/' ? 'page' : undefined}>{profile.name}</a>
    <nav class="sheets" aria-label="Sheets">
      <ul>
        {nav.map((s) => (
          <li>
            <a href={s.href} aria-current={current(s.href, s.n)}>
              <span class="label">{s.label}</span>
              {active === s.n && <span class="rule" transition:name="sheet-rule" aria-hidden="true" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle colour theme" title="Toggle theme">
      <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </div>
</header>

<script>
  // The header is swapped on every navigation, so the toggle is bound again on each page load.
  const root = document.documentElement;
  const effective = () =>
    root.getAttribute('data-theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  function bindToggle() {
    const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    btn.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  }
  document.addEventListener('astro:page-load', bindToggle);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    /* Standard property only: with both spellings written out, the minifier kept only the
       -webkit- one, which Chrome and Firefox ignore, so the blur never applied there. */
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .progress {
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1.5rem;
    min-height: 56px;
  }
  .wordmark {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--text);
    white-space: nowrap;
  }
  .sheets {
    justify-self: end;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sheets::-webkit-scrollbar {
    display: none;
  }
  .sheets ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sheets a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-block: 1.05rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .sheets a:hover {
    color: var(--text);
  }
  .sheets a[aria-current] {
    color: var(--text);
  }
  /* The active sheet: a red rule on the header's bottom line. It slides between sheets. */
  .rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    flex-shrink: 0;
  }
  .theme-toggle:hover {
    color: var(--text);
  }
  .theme-toggle .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon {
      display: block;
    }
  }

  /* Phones: two compact rows, the nav never disappears. */
  @media (max-width: 720px) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'mark toggle' 'nav nav';
      min-height: 0;
    }
    .wordmark {
      grid-area: mark;
      padding-block: 0.7rem;
    }
    .theme-toggle {
      grid-area: toggle;
      width: 32px;
      height: 32px;
    }
    .sheets {
      grid-area: nav;
      justify-self: stretch;
      border-top: 1px solid var(--line);
    }
    .sheets ul {
      justify-content: space-between;
      gap: 0.75rem;
    }
    .sheets a {
      padding-block: 0.6rem;
      font-size: var(--fs-small);
      gap: 0.3rem;
    }
  }
</style>
