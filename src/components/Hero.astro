---
import MetricTile from './MetricTile.astro';
import { profile } from '../data/profile';
import { climateRiskAgent, meshSeries } from '../data/projects';
import { upstreamHeadline, mergedByOrg } from '../data/upstream';
import { resumeHref } from '../lib/resume';
import type { Metric } from '../data/types';

// Baliapal, Balasore district. The low rests here when nobody is pointing.
const home = { lon: 87.1, lat: 21.6 };

// Three results, each with its baseline in the label and its evidence one click away.
const inGraphWeather = mergedByOrg.find((o) => o.name === 'graph_weather')?.merged;
const skill = meshSeries.finding.metric;
const citations = climateRiskAgent.metrics.find((m) => m.label.startsWith('citation validity'));
if (!inGraphWeather || !citations) throw new Error('Hero: a headline figure is missing from the data');
const stats: Metric[] = [
  {
    label: `merged PRs in open source, ${inGraphWeather} in graph_weather`,
    value: String(upstreamHeadline.merged),
    verifiedAt: upstreamHeadline.verifiedAt,
    source: '/open-source/#ledger',
    evidence: 'PR ledger',
  },
  {
    // PR #237: held-out region-weighted MSE 0.206 with the old decoder, 0.171 with the fix:
    // (0.206 - 0.171) / 0.206 = 17% lower.
    label: 'lower forecast error on unseen regions after my fix',
    value: '17%',
    verifiedAt: skill.verifiedAt,
    source: skill.source,
    evidence: 'PR #237',
  },
  {
    // 47 of 49 held-out answers; the coverage (how often it refused) is on the project card below.
    label: "of the climate agent's held-out answers cite the right page",
    value: citations.value,
    verifiedAt: citations.verifiedAt,
    source: citations.source,
    evidence: 'README',
    fast: false,
  },
];
---

<section id="top" class="hero" data-hero data-home-lon={home.lon} data-home-lat={home.lat} aria-label="Introduction">
  <div class="chart" data-chart>
    <canvas class="hero-canvas" data-base aria-hidden="true"></canvas>
    <canvas class="hero-canvas" data-part aria-hidden="true"></canvas>
    <button class="motion mono" type="button" data-motion hidden>Pause</button>
    <p class="corner bl mono">Synthetic weather · Bay of Bengal<span class="hint"> · your cursor is the storm</span></p>
    <p class="corner br mono">{profile.domain}</p>
  </div>

  <div class="overlay">
    <div class="wrap">
      <div class="legend card boxed" data-legend>
        <p class="status mono"><span class="dot" aria-hidden="true"></span>{profile.availability.replace(/ · /g, '\u00a0· ')}</p>
        <h1 class="name">{profile.name}</h1>
        <p class="pitch">{profile.tagline}</p>
        <div class="stats">
          {stats.map((m) => <MetricTile metric={m} size="lg" />)}
        </div>
        <div class="cta">
          <a class="btn primary" href="/work/">See the work</a>
          {resumeHref && <a class="btn" href={resumeHref} target="_blank" rel="noopener">Résumé</a>}
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn" href={`mailto:${profile.email}`}>Email</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line-strong);
  }
  .chart {
    position: relative;
    min-height: clamp(460px, 76vh, 760px);
    overflow: hidden;
    background: var(--bg);
    cursor: crosshair;
  }
  /* Desktop: the chart and the legend share one grid cell, so the hero is as tall as the
     taller of the two. On a short laptop screen the chart grows to hold the card, instead of
     the card hanging out of the bottom of the chart. */
  @media (min-width: 761px) {
    .hero {
      display: grid;
    }
    .chart,
    .overlay {
      grid-area: 1 / 1;
    }
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Pause and play for the chart's motion. Shown by the script, only when the chart animates. */
  .motion {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    z-index: 2;
    font-size: var(--fs-label);
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border: 1px solid var(--line-strong);
    padding: 0.15rem 0.55rem;
    cursor: pointer;
    transition: color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .motion:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .motion[hidden] {
    display: none;
  }
  /* Captions sit on a backing like a map label, so the station figures never run through them. */
  .corner {
    position: absolute;
    z-index: 2;
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    padding: 0.1rem 0.4rem;
    pointer-events: none;
  }
  /* Only a mouse can steer the storm, so only a mouse is told. */
  @media (hover: none), (pointer: coarse) {
    .hint {
      display: none;
    }
  }
  /* Above the row of longitude labels along the bottom edge. */
  .corner.bl {
    left: 1rem;
    bottom: 1.6rem;
  }
  .corner.br {
    right: 1rem;
    bottom: 1.6rem;
  }
  .overlay {
    position: relative;
    z-index: 3;
    pointer-events: none;
  }
  .overlay .wrap {
    height: 100%;
    display: flex;
    padding-block: clamp(1.5rem, 5vh, 3rem);
  }
  .legend {
    position: relative;
    pointer-events: auto;
    /* The headline is sized against the card (cqi, below). A size container cannot take its
       width from its own content, so the width is given here. */
    container-type: inline-size;
    width: 100%;
    max-width: 560px;
    /* Centred top to bottom. When the chart is only as tall as the card, the auto margins
       come to zero and the card sits at the top. */
    margin-block: auto;
    display: grid;
    gap: 1rem;
    padding: 1.5rem 1.6rem 1.4rem;
    /* Opaque, so the moving chart never shows through behind the text. */
    background: var(--card);
  }
  /* Availability, as a tab on the card's top edge, so it adds no height to the card. */
  .status {
    position: absolute;
    top: 0;
    left: 1.6rem;
    max-width: calc(100% - 3.2rem);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0.6rem;
    font-size: var(--fs-label);
    line-height: 1.5;
    /* No extra tracking: the line fits the desktop card in one row. */
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--text);
    /* When it wraps (phones), a line never starts with the separator. */
    text-wrap: balance;
  }
  .dot {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok);
  }
  /* Three pulses, then still: under five seconds, so it needs no pause control. */
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: status-pulse 1.5s var(--ease) 3;
    }
  }
  @keyframes status-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }
  /* The name is the headline. Martian Mono is wide: 18 characters fit one line of the card
     at 7.8% of its width, so the size follows the card; on a phone it wraps into two lines. */
  /* One line from a 360px phone up: about 22px there, 39px on the desktop card. */
  .name {
    font-size: clamp(1.4rem, 7.8cqi, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .pitch {
    margin-top: -0.25rem;
    font-size: var(--fs-lede);
    line-height: 1.45;
    color: var(--text);
    text-wrap: balance;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
  }
  /* The three evidence links share one baseline, however long each label runs. */
  .stats :global(.metric) {
    grid-template-rows: auto 1fr auto;
  }
  /* The figures stay below the name in weight: the name leads, the proof follows. */
  .stats :global(.metric--lg .metric-value) {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
  }
  /* Five buttons fit one row of the desktop card. */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.2rem;
  }
  @media (max-width: 760px) {
    /* Shorter on phones, so the name and the proof reach the first screen. */
    .chart {
      min-height: 0;
      height: 200px;
    }
    .overlay {
      position: static;
      pointer-events: auto;
    }
    .overlay .wrap {
      height: auto;
      padding-block: 0;
      display: block;
    }
    .legend {
      max-width: none;
      margin-top: -3rem;
      margin-bottom: 2rem;
      position: relative;
      z-index: 3;
    }
    /* The card overlaps the bottom 3rem of the chart and its status tab rises above that: lift
       the corner captions clear of both. */
    .corner.bl,
    .corner.br {
      bottom: 4.75rem;
    }
    /* Clear of the map's own latitude tick labels along the left edge. */
    .corner.bl {
      left: 2.6rem;
    }
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
    }
  }
  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
    }
    /* Figure on the left, what it measures and its evidence beside it: three results in
       half the height, so the buttons reach the first screen. */
    .stats :global(.metric) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 0.75rem;
      align-items: baseline;
    }
    .stats :global(.metric-value) {
      grid-row: 1 / 3;
      white-space: nowrap;
    }
    .pitch {
      font-size: var(--fs-body);
    }
    .stats :global(.metric-label),
    .stats :global(.receipt) {
      grid-column: 2;
    }
    /* Too narrow for a tab: the status becomes the card's first line and may wrap. */
    .status {
      position: static;
      transform: none;
      max-width: none;
      justify-self: start;
      font-size: var(--fs-label);
      letter-spacing: 0.04em;
    }
    /* This narrow, the strip above the card is too short for captions: they would sit on the
       storm's own labels. The domain also repeats the header wordmark. */
    .corner.bl,
    .corner.br {
      display: none;
    }
  }
</style>

<script>
  import { createSynoptic } from '../lib/synoptic';

  // Set up on every page load (first visit and each client-side navigation), torn down
  // before the next swap, so listeners and the animation loop never pile up.
  let teardown: (() => void) | null = null;

  function init() {
    teardown?.();
    teardown = null;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const chart = hero?.querySelector<HTMLElement>('[data-chart]') ?? null;
    const base = hero?.querySelector<HTMLCanvasElement>('[data-base]') ?? null;
    const part = hero?.querySelector<HTMLCanvasElement>('[data-part]') ?? null;
    const legend = hero?.querySelector<HTMLElement>('[data-legend]') ?? null;
    if (!hero || !chart || !base || !part) return;

    const ac = new AbortController();
    const { signal } = ac;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;
    const home: [number, number] = [Number(hero.dataset.homeLon), Number(hero.dataset.homeLat)];
    // The visitor can pause the motion (WCAG 2.2.2), and the choice is remembered like the theme.
    let paused = false;
    try {
      paused = localStorage.getItem('chart-motion') === 'paused';
    } catch {}
    const still = () => reduce || paused;
    const syn = createSynoptic({ base, part, themeRoot: document.documentElement, home, reduce });
    // Where the card covers the chart (its status tab rises about 20px above its top edge).
    const keepOut = () => {
      if (!legend) return null;
      const r = chart.getBoundingClientRect();
      const c = legend.getBoundingClientRect();
      if (c.top >= r.bottom || c.bottom <= r.top) return null;
      return { x: c.left - r.left, y: c.top - r.top - 20, w: c.width, h: c.height + 20 };
    };
    syn.setKeepOut(keepOut());
    syn.resize();
    if (still()) syn.once();
    else syn.start();

    // The pointer is the low; the low carries its own pressure and position labels.
    // The low never slides under the legend card: beside the card it stops at the card's
    // edge, and over the card (or left of it) it lets go and drifts home, so nothing swirls
    // under the text while it is being read.
    if (fine) {
      hero.addEventListener(
        'pointermove',
        (e) => {
          const r = chart.getBoundingClientRect();
          let x = e.clientX - r.left;
          const y = e.clientY - r.top;
          let free = !(legend?.contains(e.target as Node) ?? false);
          if (free && legend) {
            const c = legend.getBoundingClientRect();
            const edge = c.right - r.left + 48;
            // Only when the card stands beside open chart (desktop), not across the full width.
            if (edge < r.width - 48 && e.clientY > c.top - 48 && e.clientY < c.bottom + 48) {
              if (e.clientX < c.left) free = false;
              else x = Math.max(x, edge);
            }
          }
          if (free && x >= 0 && y >= 0 && x <= r.width && y <= r.height) syn.setPointer(x, y);
          else syn.clearPointer();
        },
        { signal },
      );
      hero.addEventListener(
        'pointerleave',
        () => syn.clearPointer(),
        { signal },
      );
    }

    // Redraw at the new size after the window changes, or after the chart itself grows to hold
    // the legend card (a short screen, or the web font arriving).
    let rt = 0;
    let size = `${chart.clientWidth}x${chart.clientHeight}`;
    const onResize = () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        size = `${chart.clientWidth}x${chart.clientHeight}`;
        syn.setKeepOut(keepOut());
        syn.resize();
        if (still()) syn.once();
      }, 120);
    };
    window.addEventListener('resize', onResize, { signal });
    const ro = new ResizeObserver(() => {
      if (`${chart.clientWidth}x${chart.clientHeight}` !== size) onResize();
    });
    ro.observe(chart);

    // Draw only while the chart is on screen and the tab is visible.
    let visible = !document.hidden;
    let onScreen = true;
    const sync = () => (visible && onScreen && !paused ? syn.start() : syn.stop());
    document.addEventListener(
      'visibilitychange',
      () => {
        visible = !document.hidden;
        sync();
      },
      { signal },
    );
    const io =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) => {
              for (const e of entries) onScreen = e.isIntersecting;
              sync();
            },
            { threshold: 0 },
          )
        : null;
    io?.observe(chart);

    const toggle = hero.querySelector<HTMLButtonElement>('[data-motion]');
    if (toggle && !reduce) {
      const label = () => {
        toggle.textContent = paused ? 'Play' : 'Pause';
        toggle.setAttribute('aria-label', paused ? 'Play the chart animation' : 'Pause the chart animation');
      };
      label();
      toggle.hidden = false;
      toggle.addEventListener(
        'click',
        () => {
          paused = !paused;
          try {
            localStorage.setItem('chart-motion', paused ? 'paused' : 'playing');
          } catch {}
          label();
          sync();
        },
        { signal },
      );
    }

    // Theme changes: the renderer reads its colours from CSS tokens.
    const mo = new MutationObserver(() => syn.retheme());
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => syn.retheme(), { signal });

    // Redraw the static frame once the chart font has arrived.
    if (still() && document.fonts) document.fonts.ready.then(() => still() && syn.once());

    teardown = () => {
      ac.abort();
      io?.disconnect();
      ro.disconnect();
      mo.disconnect();
      clearTimeout(rt);
      syn.stop();
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
