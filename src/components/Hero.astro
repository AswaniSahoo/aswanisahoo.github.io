---
import MetricTile from './MetricTile.astro';
import { profile } from '../data/profile';
import { docathon } from '../data/projects';
import { upstreamHeadline, mergedByOrg, ledgerId } from '../data/upstream';
import { resumeHref } from '../lib/resume';

// Baliapal, Balasore district. The low rests here when nobody is pointing.
const home = { lon: 87.1, lat: 21.6 };

// One sentence per line, so a line never ends halfway through an idea.
const beats = profile.tagline.split(/(?<=\.)\s+/);

const stats = [
  {
    metric: {
      label: `merged upstream PRs across ${upstreamHeadline.orgs} orgs`,
      value: String(upstreamHeadline.merged),
      verifiedAt: upstreamHeadline.verifiedAt,
      source: '/open-source/#ledger',
      evidence: 'PR ledger',
    },
  },
  {
    metric: {
      label: 'flagship systems evaluated on held-out sets',
      value: '2',
      verifiedAt: '2026-09-30',
      source: '#work',
      evidence: 'both reports',
    },
  },
  {
    metric: {
      label: `of 33 contributors, ${docathon.title}, ${docathon.result}`,
      value: '7th',
      verifiedAt: docathon.verifiedAt,
      source: docathon.source,
    },
  },
];
---

<section id="top" class="hero" data-hero data-home-lon={home.lon} data-home-lat={home.lat} aria-label="Introduction">
  <div class="chart" data-chart>
    <canvas class="hero-canvas" data-base aria-hidden="true"></canvas>
    <canvas class="hero-canvas" data-part aria-hidden="true"></canvas>
    <button class="motion mono" type="button" data-motion hidden>Pause</button>
    <p class="corner bl mono">Surface analysis · Bay of Bengal sheet · synthetic field</p>
    <p class="corner br mono">{profile.domain}</p>
  </div>

  <div class="overlay">
    <div class="wrap">
      <div class="legend card boxed" data-legend>
        <p class="status mono"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
        <p class="eyebrow"><b>{profile.name}</b> · <span class="role">{profile.title}</span></p>
        <h1>{beats.map((b, i) => <>{i > 0 && ' '}<span class="beat">{b}</span></>)}</h1>
        <p class="intro">{profile.intro}</p>
        <div class="stats">
          {stats.map((s) => <MetricTile metric={s.metric} size="lg" />)}
        </div>
        <p class="orgs">
          <span class="mono">Merged in</span>
          {mergedByOrg.map((o, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={`/open-source/#${ledgerId(o.name)}`}>{o.name}</a></>)}
        </p>
        <div class="cta">
          <a class="btn primary" href="/work/">See the work</a>
          {resumeHref && <a class="btn" href={resumeHref} target="_blank" rel="noopener">Résumé</a>}
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn" href={`mailto:${profile.email}`}>Email</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line-strong);
  }
  .chart {
    position: relative;
    min-height: clamp(460px, 76vh, 760px);
    overflow: hidden;
    background: var(--bg);
    cursor: crosshair;
  }
  /* Desktop: the chart and the legend share one grid cell, so the hero is as tall as the
     taller of the two. On a short laptop screen the chart grows to hold the card, instead of
     the card hanging out of the bottom of the chart. */
  @media (min-width: 761px) {
    .hero {
      display: grid;
    }
    .chart,
    .overlay {
      grid-area: 1 / 1;
    }
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Pause and play for the chart's motion. Shown by the script, only when the chart animates. */
  .motion {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    z-index: 2;
    font-size: 0.62rem;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border: 1px solid var(--line-strong);
    padding: 0.15rem 0.55rem;
    cursor: pointer;
    transition: color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .motion:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .motion[hidden] {
    display: none;
  }
  .corner {
    position: absolute;
    z-index: 2;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    pointer-events: none;
  }
  .corner.bl {
    left: 1rem;
    bottom: 0.75rem;
  }
  .corner.br {
    right: 1rem;
    bottom: 0.75rem;
  }
  .overlay {
    position: relative;
    z-index: 3;
    pointer-events: none;
  }
  .overlay .wrap {
    height: 100%;
    display: flex;
    padding-block: clamp(1.5rem, 5vh, 3rem);
  }
  .legend {
    position: relative;
    pointer-events: auto;
    /* The headline is sized against the card (cqi, below). A size container cannot take its
       width from its own content, so the width is given here. */
    container-type: inline-size;
    width: 100%;
    max-width: 560px;
    /* Centred top to bottom. When the chart is only as tall as the card, the auto margins
       come to zero and the card sits at the top. */
    margin-block: auto;
    display: grid;
    gap: 1rem;
    padding: 1.5rem 1.6rem 1.4rem;
    /* Opaque, so the moving chart never shows through behind the text. */
    background: var(--card);
  }
  .legend .eyebrow {
    color: var(--muted);
  }
  .legend .eyebrow b {
    color: var(--text);
    font-weight: 600;
  }
  /* On phones the eyebrow wraps before the title, never inside "ML / AI". */
  .role {
    white-space: nowrap;
  }
  /* Availability, as a tab on the card's top edge, so it adds no height to the card. */
  .status {
    position: absolute;
    top: 0;
    left: 1.6rem;
    max-width: calc(100% - 3.2rem);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0.6rem;
    font-size: 0.64rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--text);
  }
  .dot {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok);
  }
  /* Three pulses, then still: under five seconds, so it needs no pause control. */
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: status-pulse 1.5s var(--ease) 3;
    }
  }
  @keyframes status-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }
  /* The orgs behind the merged count, each linking to its group in the ledger. */
  .orgs {
    margin-top: -0.35rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .orgs .mono {
    margin-right: 0.45rem;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .orgs a {
    color: var(--text);
    text-decoration-color: var(--line-strong);
    white-space: nowrap;
  }
  /* One sentence per line. Martian Mono is wide: a 24-character line fits the card only at 6%
     of the card's width or less, so the size follows the card down to the phone floor. Below
     the floor, each sentence breaks into an even pair of lines. */
  .legend h1 {
    font-size: clamp(1.45rem, 6cqi, 1.95rem);
    margin-top: -0.35rem;
  }
  .beat {
    display: block;
    text-wrap: balance;
  }
  .intro {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 58ch;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
  }
  /* The three evidence links share one baseline, however long each label runs. */
  .stats :global(.metric) {
    grid-template-rows: auto 1fr auto;
  }
  /* Five buttons fit one row of the desktop card. */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.2rem;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--text);
    color: var(--text);
    transition: background 200ms var(--ease), color 200ms var(--ease), transform 200ms var(--ease);
  }
  .btn:hover {
    background: var(--text);
    color: var(--bg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .btn:hover {
      transform: translateY(-1px);
    }
  }
  .btn.primary {
    background: var(--text);
    color: var(--bg);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 760px) {
    .chart {
      min-height: 0;
      height: 320px;
    }
    .overlay {
      position: static;
      pointer-events: auto;
    }
    .overlay .wrap {
      height: auto;
      padding-block: 0;
      display: block;
    }
    .legend {
      max-width: none;
      margin-top: -3rem;
      margin-bottom: 2rem;
      position: relative;
      z-index: 3;
    }
    /* The card overlaps the bottom 3rem of the chart and its status tab rises above that: lift
       the corner captions clear of both. */
    .corner.bl,
    .corner.br {
      bottom: 4.75rem;
    }
    /* Clear of the map's own latitude tick labels along the left edge. */
    .corner.bl {
      left: 2.6rem;
    }
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
    }
  }
  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
    }
    /* Each sentence takes two lines here; a little air keeps the three pairs apart. */
    .beat + .beat {
      margin-top: 0.25em;
    }
    /* One line down to a 360px phone. */
    .status {
      left: 0.75rem;
      max-width: calc(100% - 1.5rem);
      gap: 0.4rem;
      padding-inline: 0.5rem;
      font-size: 0.58rem;
      letter-spacing: 0;
    }
    /* The domain repeats the header wordmark and, this narrow, brushes the map's station labels. */
    .corner.br {
      display: none;
    }
  }
</style>

<script>
  import { createSynoptic } from '../lib/synoptic';

  // Set up on every page load (first visit and each client-side navigation), torn down
  // before the next swap, so listeners and the animation loop never pile up.
  let teardown: (() => void) | null = null;

  function init() {
    teardown?.();
    teardown = null;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const chart = hero?.querySelector<HTMLElement>('[data-chart]') ?? null;
    const base = hero?.querySelector<HTMLCanvasElement>('[data-base]') ?? null;
    const part = hero?.querySelector<HTMLCanvasElement>('[data-part]') ?? null;
    const legend = hero?.querySelector<HTMLElement>('[data-legend]') ?? null;
    if (!hero || !chart || !base || !part) return;

    const ac = new AbortController();
    const { signal } = ac;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches;
    const home: [number, number] = [Number(hero.dataset.homeLon), Number(hero.dataset.homeLat)];
    // The visitor can pause the motion (WCAG 2.2.2), and the choice is remembered like the theme.
    let paused = false;
    try {
      paused = localStorage.getItem('chart-motion') === 'paused';
    } catch {}
    const still = () => reduce || paused;
    const syn = createSynoptic({ base, part, themeRoot: document.documentElement, home, reduce });
    syn.resize();
    if (still()) syn.once();
    else syn.start();

    // The pointer is the low; the low carries its own pressure and position labels.
    // The low never slides under the legend card: beside the card it stops at the card's
    // edge, and over the card (or left of it) it lets go and drifts home, so nothing swirls
    // under the text while it is being read.
    if (fine) {
      hero.addEventListener(
        'pointermove',
        (e) => {
          const r = chart.getBoundingClientRect();
          let x = e.clientX - r.left;
          const y = e.clientY - r.top;
          let free = !(legend?.contains(e.target as Node) ?? false);
          if (free && legend) {
            const c = legend.getBoundingClientRect();
            const edge = c.right - r.left + 48;
            // Only when the card stands beside open chart (desktop), not across the full width.
            if (edge < r.width - 48 && e.clientY > c.top - 48 && e.clientY < c.bottom + 48) {
              if (e.clientX < c.left) free = false;
              else x = Math.max(x, edge);
            }
          }
          if (free && x >= 0 && y >= 0 && x <= r.width && y <= r.height) syn.setPointer(x, y);
          else syn.clearPointer();
        },
        { signal },
      );
      hero.addEventListener(
        'pointerleave',
        () => syn.clearPointer(),
        { signal },
      );
    }

    // Redraw at the new size after the window changes, or after the chart itself grows to hold
    // the legend card (a short screen, or the web font arriving).
    let rt = 0;
    let size = `${chart.clientWidth}x${chart.clientHeight}`;
    const onResize = () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        size = `${chart.clientWidth}x${chart.clientHeight}`;
        syn.resize();
        if (still()) syn.once();
      }, 120);
    };
    window.addEventListener('resize', onResize, { signal });
    const ro = new ResizeObserver(() => {
      if (`${chart.clientWidth}x${chart.clientHeight}` !== size) onResize();
    });
    ro.observe(chart);

    // Draw only while the chart is on screen and the tab is visible.
    let visible = !document.hidden;
    let onScreen = true;
    const sync = () => (visible && onScreen && !paused ? syn.start() : syn.stop());
    document.addEventListener(
      'visibilitychange',
      () => {
        visible = !document.hidden;
        sync();
      },
      { signal },
    );
    const io =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) => {
              for (const e of entries) onScreen = e.isIntersecting;
              sync();
            },
            { threshold: 0 },
          )
        : null;
    io?.observe(chart);

    const toggle = hero.querySelector<HTMLButtonElement>('[data-motion]');
    if (toggle && !reduce) {
      const label = () => {
        toggle.textContent = paused ? 'Play' : 'Pause';
        toggle.setAttribute('aria-label', paused ? 'Play the chart animation' : 'Pause the chart animation');
      };
      label();
      toggle.hidden = false;
      toggle.addEventListener(
        'click',
        () => {
          paused = !paused;
          try {
            localStorage.setItem('chart-motion', paused ? 'paused' : 'playing');
          } catch {}
          label();
          sync();
        },
        { signal },
      );
    }

    // Theme changes: the renderer reads its colours from CSS tokens.
    const mo = new MutationObserver(() => syn.retheme());
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => syn.retheme(), { signal });

    // Redraw the static frame once the chart font has arrived.
    if (still() && document.fonts) document.fonts.ready.then(() => still() && syn.once());

    teardown = () => {
      ac.abort();
      io?.disconnect();
      ro.disconnect();
      mo.disconnect();
      clearTimeout(rt);
      syn.stop();
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
