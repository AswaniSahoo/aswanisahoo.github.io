---
interface Props {
  id: string;
  /** The small label above the title, e.g. "Projects". */
  label: string;
  title: string;
  lede?: string;
  /** Tighter rhythm for short home-sheet sections. */
  compact?: boolean;
}
const { id, label, title, lede, compact = false } = Astro.props;
---

<section id={id} class:list={['section', { compact }]}>
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{label}</p>
      <h2>{title}</h2>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <slot />
  </div>
</section>
