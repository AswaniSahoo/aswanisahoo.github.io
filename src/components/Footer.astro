---
import { profile } from '../data/profile';
import ledger from '../data/prs.json';
import { sheets, sheetById, type SheetId } from '../data/sheets';

interface Props {
  /** The sheet this page belongs to, named in the strip. */
  sheet?: SheetId;
  /** Strip text for pages outside the five sheets (404). */
  strip?: string;
}
const { sheet, strip = '' } = Astro.props;
const s = sheet ? sheetById(sheet) : undefined;
const total = String(sheets.length).padStart(2, '0');
const now = new Date();
const built = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
---

<footer class="site-footer">
  <div class="wrap body">
    <p class="mono note">
      Every public number links to its evidence: an eval report, a CI run, or the pull request itself; numbers from private repos are marked private. PR ledger regenerated from the GitHub API on {ledger.verifiedAt}. Built {built} with Astro, no client framework.
    </p>
    <p class="links">
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.links.x} target="_blank" rel="noopener noreferrer">X</a>
      <a href={profile.links.blog} target="_blank" rel="noopener noreferrer">Blog</a>
      <a href={`mailto:${profile.email}`}>Email</a>
    </p>
  </div>
  <div class="strip">
    <p class="wrap strip-row mono">
      <span>{s ? <><b>Sheet {s.n}</b> of {total} · {s.name}</> : strip}</span>
      <span>{profile.domain}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .body {
    display: grid;
    gap: 1rem;
    padding-block: 2.5rem 2rem;
  }
  .note {
    font-size: 0.75rem;
    max-width: 80ch;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }
  .links a {
    text-decoration: none;
  }
  .strip {
    border-top: 1px solid var(--line-strong);
    background: var(--bg-2);
  }
  .strip-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.8rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .strip-row b {
    color: var(--accent);
    font-weight: 500;
  }
</style>
