---
import { profile } from '../data/profile';
import type { SheetId } from '../data/sheets';

interface Props {
  /** The page this footer closes. Kept for the layout's call; the strip no longer numbers pages. */
  sheet?: SheetId;
  /** Strip text for pages outside the five (404). */
  strip?: string;
}
const { strip } = Astro.props;
const now = new Date();
const built = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
---

<footer class="site-footer">
  <div class="wrap body">
    <p class="note">Every number on this site links to its evidence, or says so when the repository is private. Built with Astro, no client framework.</p>
  </div>
  <div class="strip">
    <p class="wrap strip-row mono">
      <span>{strip ?? `© ${now.getFullYear()} ${profile.name}`}</span>
      <span>Updated {built}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .body {
    padding-block: 1.5rem;
  }
  .note {
    font-size: var(--fs-small);
    max-width: 80ch;
  }
  .strip {
    border-top: 1px solid var(--line-strong);
    background: var(--bg-2);
  }
  .strip-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.8rem;
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
  }
</style>
