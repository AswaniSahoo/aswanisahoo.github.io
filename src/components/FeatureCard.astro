---
/**
 * A flagship project: what it does in one plain sentence, one result with its evidence,
 * a few tags, and the whole card as one link to the case study.
 */
import Receipt from './Receipt.astro';
import { reportHref, type Featured } from '../data/work';

interface Props {
  project: Featured;
}
const { project: p } = Astro.props;
---

<article class="card feature">
  <p class="eyebrow">{p.eyebrow}</p>
  <h3><a href={reportHref(p.slug)}>{p.name}</a></h3>
  <p class="outcome">{p.outcome}</p>
  <div class="result">
    <span class="value mono">{p.metric.value}</span>
    <span class="what">
      {p.metric.label}
      <Receipt source={p.metric.source} label={p.metric.evidence} verifiedAt={p.metric.verifiedAt} isPrivate={p.isPrivate} />
    </span>
  </div>
  <ul class="chips">
    {p.tags.map((t) => <li>{t}</li>)}
  </ul>
  <p class="foot mono">
    <span class="read" aria-hidden="true">Case study</span>
    {p.live && <a class="live" href={p.live} target="_blank" rel="noopener noreferrer">Try it live</a>}
  </p>
</article>

<style>
  /* Six rows shared with the neighbouring card when the grid around it allows (FeatureGrid). */
  .feature {
    position: relative;
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0.85rem;
    align-content: start;
    padding: 1.5rem 1.5rem 1.3rem;
  }
  .feature:focus-within {
    border-color: var(--text);
  }
  h3 a {
    text-decoration: none;
  }
  /* The whole card is the link; the evidence link sits above it. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .outcome {
    font-size: var(--fs-text);
    color: var(--muted);
    max-width: 52ch;
  }
  /* One result: the figure, then what it measures and where it is proven. */
  .result {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.4rem 1rem;
    align-items: baseline;
    align-content: start;
    padding-top: 0.9rem;
  }
  .result::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 4px, transparent 4px 7px);
    transform-origin: left center;
  }
  .value {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }
  .what {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--muted);
  }
  .what :global(.receipt) {
    position: relative;
    z-index: 1;
  }
  .foot {
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .read {
    color: var(--text);
  }
  .read::after {
    content: ' →';
    color: var(--accent);
  }
  /* Above the card's own link, like the evidence link. */
  .live {
    position: relative;
    z-index: 1;
    color: var(--accent);
    text-decoration: none;
  }
  .live::after {
    content: ' ↗';
  }
  .live:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .feature:hover .read {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }
  /* As the card arrives, the rule is drawn, then the result lands (global.css, Motion). Only a
     card waiting inside an unrevealed .reveal starts hidden. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .result::before {
      transition: transform 900ms var(--ease) calc(var(--delay, 0ms) + 250ms);
    }
    .result > * {
      transition:
        opacity 500ms var(--ease) calc(var(--delay, 0ms) + 550ms),
        transform 500ms var(--ease) calc(var(--delay, 0ms) + 550ms);
    }
    :global(html.js .reveal:not(.is-in)) .result::before {
      transform: scaleX(0);
    }
    :global(html.js .reveal:not(.is-in)) .result > * {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
