---
/**
 * Contribution graph: me at the centre, one node per upstream project on a ring around it.
 * Node size and line weight both follow the merged PR count. Labels sit outward of each node,
 * away from its line, so no line ever crosses a name.
 *
 * Drawn complete from first paint: no reveal fade and no draw-in, so nothing is hidden before
 * a script runs and a capture taken at any moment shows the whole graph. The drawing is
 * 350 units wide, so the 12.5px names stay near 12px on a 390px phone.
 */
interface Props {
  counts: Record<string, number>;
}
const { counts } = Astro.props;

const W = 350;
const H = 324;
const hub = { x: 175, y: 172, r: 32 };
const rx = 108;
const ry = 112;

// Ring order, clockwise from the upper left: the largest org first, as the ledger sorts them.
const preferred = ['graph_weather', 'PyTorch', 'ExecuTorch', 'krkn-chaos', 'MalariaGEN'];
const names = [
  ...preferred.filter((n) => counts[n] !== undefined),
  ...Object.keys(counts).filter((n) => !preferred.includes(n) && counts[n] > 0),
];
const step = 360 / Math.max(names.length, 1);
const nodes = names.map((name, i) => {
  const a = ((-72 + i * step) * Math.PI) / 180;
  const n = counts[name];
  const x = hub.x + rx * Math.sin(a);
  const y = hub.y - ry * Math.cos(a);
  const r = 14 + n * 1.2;
  const above = y < hub.y + 8;
  return {
    name,
    n,
    x,
    y,
    r,
    w: 1.4 + n * 0.42,
    labelY: above ? y - r - 9 : y + r + 17,
    size: r > 30 ? 21 : 14,
  };
});
const summary = nodes.map((n) => `${n.name} ${n.n}`).join(', ');
const f = (v: number) => v.toFixed(1);
---

<figure class="graph">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="graph-title graph-desc">
    <title id="graph-title">Merged pull requests by upstream project</title>
    <desc id="graph-desc">{`Merged pull requests per project: ${summary}. Node size and line weight follow the count.`}</desc>
    <g class="edges" fill="none">
      {nodes.map((n) => (
        <line x1={hub.x} y1={hub.y} x2={f(n.x)} y2={f(n.y)} style={`stroke-width: ${n.w.toFixed(1)}`} />
      ))}
    </g>
    {nodes.map((n) => (
      <g class="node">
        <circle cx={f(n.x)} cy={f(n.y)} r={f(n.r)} />
        <text x={f(n.x)} y={f(n.y + n.size * 0.35)} text-anchor="middle" class="n mono" font-size={n.size}>{n.n}</text>
        <text x={f(n.x)} y={f(n.labelY)} text-anchor="middle" class="label mono">{n.name}</text>
      </g>
    ))}
    <g class="me">
      <circle cx={hub.x} cy={hub.y} r={hub.r} />
      <text x={hub.x} y={hub.y + 5} text-anchor="middle" class="mono" font-size="15">me</text>
    </g>
  </svg>
</figure>

<style>
  .graph {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 400px;
    height: auto;
    margin-inline: auto;
  }
  .edges line {
    stroke: var(--text);
    opacity: 0.55;
    stroke-linecap: round;
  }
  .node circle {
    fill: var(--card);
    stroke: var(--accent);
    stroke-width: 2.4;
  }
  .node .n {
    fill: var(--text);
    font-weight: 600;
  }
  .label {
    fill: var(--text);
    font-size: 12.5px;
    font-weight: 500;
    /* A halo in the panel colour keeps the name readable over the graticule. */
    paint-order: stroke;
    stroke: var(--bg-2);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .me circle {
    fill: var(--accent);
  }
  .me text {
    fill: var(--bg);
    font-weight: 600;
  }
</style>
