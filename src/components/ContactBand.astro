---
/** Home sheet: the contact band above the footer strip. */
import { profile } from '../data/profile';
---

<section id="contact" class="contact">
  <div class="wrap inner reveal">
    <div>
      <p class="eyebrow"><b>Contact</b> / {profile.location}</p>
      <h2>Write to me</h2>
    </div>
    <div class="ways">
      <a class="mail mono" href={`mailto:${profile.email}`}>{profile.email}</a>
      <p class="links mono">
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={profile.links.x} target="_blank" rel="noopener noreferrer">X</a>
        <a class="internal" href="/writing/">Writing</a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line-strong);
    background: var(--card);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem 2.5rem;
    align-items: end;
  }
  h2 {
    margin-top: 0.6rem;
  }
  .ways {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .mail {
    font-size: clamp(0.95rem, 2.2vw, 1.3rem);
    font-weight: 500;
    text-decoration-color: var(--accent);
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .links a {
    text-decoration: none;
  }
  .links a::before {
    content: '↗ ';
    color: var(--accent);
  }
  .links a.internal::before {
    content: '→ ';
  }
  .links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
