---
/** Home page: the contact band above the footer. */
import { profile } from '../data/profile';
import { resumeHref } from '../lib/resume';
---

<section id="contact" class="contact">
  <div class="wrap inner reveal">
    <div>
      <p class="eyebrow"><b>Contact</b> / {profile.location}</p>
      <h2>Write to me</h2>
    </div>
    <div class="ways">
      <a class="mail mono" href={`mailto:${profile.email}`}>{profile.email}</a>
      <p class="links mono">
        {resumeHref && <a class="file" href={resumeHref} target="_blank" rel="noopener">Résumé (PDF)</a>}
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={profile.links.x} target="_blank" rel="noopener noreferrer">X</a>
        <a class="internal" href="/writing/">Writing</a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line-strong);
    background: var(--card);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem 2.5rem;
    align-items: end;
  }
  h2 {
    margin-top: 0.6rem;
  }
  .ways {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  /* The address is underlined in accent, drawn in as the band arrives (global.css, Motion). */
  .mail {
    font-size: clamp(0.95rem, 2.2vw, 1.3rem);
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 100% 1px no-repeat;
    padding-bottom: 0.15em;
    overflow-wrap: anywhere;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    .mail {
      transition: background-size 1s var(--ease) 350ms, color 200ms var(--ease);
    }
    :global(html.js) .inner:not(.is-in) .mail {
      background-size: 0 1px;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
  }
  .links a {
    text-decoration: none;
  }
  .links a::before {
    content: '↗ ';
    color: var(--accent);
  }
  .links a.internal::before {
    content: '→ ';
  }
  .links a.file::before {
    content: '↓ ';
  }
  .links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
