---
/**
 * Header art for inner sheets: a static isobar strip, drawn at build time.
 * The canvas chart runs only on the home sheet; this is its quiet, printed cousin.
 * The field is synthetic and the corner label says so.
 */
import { isobarPaths } from '../lib/isobars';

interface Props {
  /** Shifts the low and the high so each sheet reads as its own chart. */
  seed?: number;
  /** Corner label, e.g. "Sheet 02 · Station reports · synthetic field". */
  label: string;
}
const { seed = 2, label } = Astro.props;

const W = 1440;
const H = 120;
// One low inside the centre band that survives the phone crop (x 525 to 915), one high to the west.
const low = { x: 640 + ((seed * 97) % 160), y: 88, sx: 340, sy: 150, depth: 24 };
const high = { x: 180 + ((seed * 61) % 140), y: 14, sx: 420, sy: 170, amp: 16 };
const P = (x: number, y: number) =>
  1012 -
  low.depth * Math.exp(-(((x - low.x) / low.sx) ** 2 + ((y - low.y) / low.sy) ** 2)) +
  high.amp * Math.exp(-(((x - high.x) / high.sx) ** 2 + ((y - high.y) / high.sy) ** 2)) +
  0.003 * (x - W / 2);
const paths = isobarPaths(P, W, H, 24, 12, 4);
const meridians = Array.from({ length: Math.floor(W / 48) }, (_, i) => (i + 1) * 48);
const parallels = [48, 96];
---

<div class="strip" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    <g class="grat">
      {meridians.map((x) => <line x1={x} y1="0" x2={x} y2={H} />)}
      {parallels.map((y) => <line x1="0" y1={y} x2={W} y2={y} />)}
    </g>
    <g class="isobars">
      {paths.map((d) => <path d={d} />)}
    </g>
    <text class="high" x={high.x} y={high.y + 22} text-anchor="middle">H</text>
    <text class="low" x={low.x} y={low.y + 9} text-anchor="middle">L</text>
  </svg>
  <div class="wrap corner-wrap">
    <p class="corner mono">{label}</p>
  </div>
</div>

<style>
  .strip {
    position: relative;
    height: 120px;
    overflow: hidden;
    background: var(--bg);
    border-bottom: 1px solid var(--line-strong);
  }
  svg {
    width: 100%;
    height: 100%;
    display: block;
    max-width: none;
  }
  .grat line {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .isobars path {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.4;
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }
  .low {
    fill: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 26px;
  }
  .high {
    fill: var(--text);
    fill-opacity: 0.75;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 22px;
  }
  .corner-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.5rem;
  }
  .corner {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    padding: 0.1rem 0.35rem;
  }
</style>
