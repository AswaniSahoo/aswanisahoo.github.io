---
/**
 * Home sheet: the upstream strip. The frozen headline, merged PRs per org straight from
 * the ledger, and the decoder root cause in one line. The full ledger lives on the
 * Open source sheet, where the headline's receipt points.
 */
import Receipt from './Receipt.astro';
import { upstreamHeadline, mergedByOrg } from '../data/upstream';
import { meshSeries } from '../data/projects';

const h = upstreamHeadline;
const fix = meshSeries.finding.metric;
// Each org row is also a bar: its share of the largest count (the ledger lists largest first).
const most = mergedByOrg[0]?.merged ?? 1;
const pr = (n: number) => `https://github.com/openclimatefix/graph_weather/pull/${n}`;
---

<section id="upstream" class="upstream chart-panel">
  <div class="wrap inner">
    <div class="headline reveal">
      <p class="eyebrow"><b>03</b> / Open source</p>
      <p class="big"><span class="num mono">{h.merged}</span> merged upstream PRs across {h.orgs} orgs</p>
      <Receipt source="/open-source/#ledger" label="PR ledger" />
    </div>

    <ul class="orgs reveal" style="--delay: 60ms" aria-label="Merged pull requests by org">
      {mergedByOrg.map((o, i) => (
        <li style={`--share: ${(o.merged / most).toFixed(3)}; --i: ${i}`}><span>{o.name}</span><b class="mono">{o.merged}</b></li>
      ))}
    </ul>

    <div class="finding reveal" style="--delay: 120ms">
      <p class="eyebrow"><b>Root cause</b> · graph_weather</p>
      <p class="line">
        Regional forecasts were stuck at persistence because the decoder seeded its observation nodes with zeros. A zero-parameter skip connection, shipped in <a href={pr(237)} target="_blank" rel="noopener noreferrer">#237</a> and <a href={pr(239)} target="_blank" rel="noopener noreferrer">#239</a>, lifted held-out skill over persistence from {fix.value.replace(' → ', ' to ')}.
      </p>
      <Receipt source={fix.source} />
    </div>

    <p class="more mono"><a href="/open-source/#ledger">Every PR, by org</a></p>
  </div>
</section>

<style>
  .upstream {
    border-left: 0;
    border-right: 0;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: 1.5rem 2.5rem;
    align-items: start;
  }
  .headline {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }
  .big {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    max-width: 22ch;
  }
  .num {
    display: block;
    font-size: clamp(2.6rem, 5vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .orgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    align-self: center;
  }
  .orgs li {
    position: relative;
    isolation: isolate;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--card);
    border: 1px solid var(--line-strong);
  }
  /* The bar behind each row: that org's share of the largest count. The figure beside it is
     printed at its final value; only the bar is plotted in. */
  .orgs li::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    width: calc(var(--share) * 100%);
    background: var(--accent-soft);
    border-right: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    transform-origin: left center;
  }
  .orgs b {
    font-weight: 600;
  }
  .finding {
    position: relative;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: 0.2rem 0 0.2rem 1rem;
  }
  .finding::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background: var(--accent);
    transform-origin: center top;
  }
  /* Plotted in as the strip arrives: the bars grow one after another, the finding's rule runs
     down (global.css, Motion). */
  @media screen and (prefers-reduced-motion: no-preference) {
    .orgs li::before {
      transition: transform 1s var(--ease) calc(var(--i) * 90ms + 200ms);
    }
    .finding::before {
      transition: transform 900ms var(--ease) 300ms;
    }
    :global(html.js) .orgs:not(.is-in) li::before {
      transform: scaleX(0);
    }
    :global(html.js) .finding:not(.is-in)::before {
      transform: scaleY(0);
    }
  }
  .line {
    font-size: 0.95rem;
    max-width: 65ch;
  }
  .more {
    grid-column: 1 / -1;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .more a {
    text-decoration: none;
  }
  .more a::after {
    content: ' →';
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
  }
  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .finding {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
