---
/**
 * Home: the open-source record. The deepest thread first, graph_weather, then every project
 * as a bar of its merged PRs (OrgBars).
 */
import Receipt from './Receipt.astro';
import OrgBars from './OrgBars.astro';
import { docathon, meshSeries } from '../data/projects';

const gw = meshSeries.metrics[0];
const pr = (n: number) => `${meshSeries.repo}/pull/${n}`;
---

<section id="upstream" class="upstream chart-panel">
  <div class="wrap inner">
    <div class="lead reveal">
      <p class="eyebrow">Open source</p>
      <h2>{gw.value} PRs in a weather model</h2>
      <p class="line">
        Open Climate Fix's graph_weather is a graph-neural-network weather model. I picked up its adaptive-mesh work in a two-month mentorship with Jacob Prince-Bieker (May to July 2026), and found why its regional forecasts barely beat a no-change forecast, fixed in <a href={pr(237)} target="_blank" rel="noopener noreferrer">#237</a> and <a href={pr(239)} target="_blank" rel="noopener noreferrer">#239</a>.
      </p>
      <Receipt source={gw.source} label="merged PRs in graph_weather" verifiedAt={gw.verifiedAt} />
    </div>

    <div class="side reveal" style="--delay: 60ms">
      <OrgBars />
      <p class="honor">
        <b>{docathon.title}</b><span>· {docathon.result.toLowerCase()}</span>
        <Receipt source={docathon.source} label="leaderboard" verifiedAt={docathon.verifiedAt} />
      </p>
      <p class="more mono"><a href="/open-source/">Every PR, by project</a></p>
    </div>
  </div>
</section>

<style>
  .upstream {
    border-left: 0;
    border-right: 0;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 2rem 3.5rem;
    align-items: start;
  }
  .lead {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .line {
    font-size: var(--fs-text);
    color: var(--muted);
    max-width: 60ch;
  }
  .honor {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    margin-top: 1rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .honor b {
    color: var(--text);
    font-weight: 600;
  }
  .more {
    margin-top: 1rem;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .more a {
    text-decoration: none;
  }
  .more a::after {
    content: ' →';
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
