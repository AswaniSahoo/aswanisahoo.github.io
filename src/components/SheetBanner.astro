---
/**
 * The top of every inner page: the static isobar strip, then a plain label line
 * ("PROJECTS · 10") and whatever the page puts under it.
 */
import IsobarStrip from './IsobarStrip.astro';
import { sheetById, type SheetId } from '../data/sheets';

interface Props {
  sheet: SheetId;
  /** The label line, joined with middle dots. */
  parts: string[];
  /** Varies the strip's synthetic field between pages. */
  seed?: number;
}
const { sheet, parts, seed } = Astro.props;
const s = sheetById(sheet);
---

<header class="banner">
  <IsobarStrip seed={seed ?? Number(s.n)} label="Synthetic weather field" />
  <div class="wrap head">
    <p class="eyebrow">{parts.join(' · ')}</p>
    <slot />
  </div>
</header>

<style>
  .head {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem) 0;
  }
  .head :global(h1) {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.1;
  }
  .head :global(.lede) {
    max-width: 65ch;
  }
</style>
